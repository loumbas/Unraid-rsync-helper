<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "rclone-jobs">
<!ENTITY author    "P. Loumpardias">
<!ENTITY version   "{{VERSION}}">
<!ENTITY launchApp "Utilities/rclone-jobs">
<!ENTITY pluginDir "/usr/local/emhttp/plugins/&name;">
<!ENTITY bootDir   "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" service="no" category="Utilities" author="&author;" version="&version;" launch="&launchApp;" min="7.0.0">
  <CHANGES>
{{CHANGES}}
  </CHANGES>
  <!--
    rclone-jobs: scheduled rclone/rsync jobs with a dry-run gate and Telegram/Dynamix
    alerts. Runs alongside (never inside) the 'rclone' plugin by Waseh and reuses its
    config at /boot/config/plugins/rclone/.rclone.conf.
    Scheduling: marked block inside /var/spool/cron/crontabs/root (Unraid's Dillon cron
    does not read /etc/cron.d and never re-reads changed crontabs -> rc.crond restart
    on change only). All plugin state lives outside /mnt/user (dot-folder on an array
    disk). License: GPL-2.0-or-later. No phone-home: the plugin performs outbound
    network requests ONLY when Telegram alerts are explicitly enabled.
  -->
  <!-- FILE entries are generated at build time from src/MANIFEST. -->
{{FILES}}
  <!-- INSTALL: runs after the files above are in place, at install/upgrade AND at every
       boot (array may be down). Boot-safe and idempotent by design. -->
  <FILE Run="/bin/bash" Method="install">
    <INLINE>
S="&pluginDir;/scripts"
if [ -x "$S/boot-setup.sh" ]; then
  "$S/boot-setup.sh"
else
  mkdir -p "&bootDir;/jobs"
fi
logger -t rclone-jobs "install script finished (v&version;)"
true
    </INLINE>
  </FILE>
  <!-- REMOVE: stops running jobs, splices our block out of the root crontab, deletes
       the code. Deliberately KEEPS /boot config and all storage data (logs, status,
       backups, notify.env) - delete those by hand if you want them gone. -->
  <FILE Run="/bin/bash" Method="remove">
    <INLINE>
pkill -f 'rclone-jobs\.sh run ' 2>/dev/null
true
CT="/var/spool/cron/crontabs/root"
if grep -qF '# rclone-jobs BEGIN' "$CT" 2>/dev/null; then
  sed -i '/^# rclone-jobs BEGIN/,/^# rclone-jobs END/d' "$CT"
  if [ -x /etc/rc.d/rc.crond ]; then
    /etc/rc.d/rc.crond restart >/dev/null 2>&amp;1
  fi
fi
rm -f /etc/cron.d/&name;
rm -rf "&pluginDir;"
logger -t rclone-jobs "&name; removed: code and schedule gone; &bootDir; and storage data kept on purpose"
true
    </INLINE>
  </FILE>
</PLUGIN>
