<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "rclone-jobs">
<!ENTITY author    "sir_lou">
<!ENTITY version   "{{VERSION}}">
<!ENTITY desc      "Schedule rclone/rsync jobs with a dry-run gate, mount guard, delete limits and native Unraid alerts (Telegram-capable)">
<!ENTITY launchApp "Utilities/rclone-jobs">
<!ENTITY pluginDir "/usr/local/emhttp/plugins/&name;">
<!ENTITY bootDir   "/boot/config/plugins/&name;">
<!ENTITY repoURL   "https://github.com/loumbas/Unraid-rsync-helper">
<!ENTITY pluginURL "https://raw.githubusercontent.com/loumbas/Unraid-rsync-helper/main/dist/rclone-jobs.plg">
]>
<PLUGIN name="&name;" service="no" author="&author;" version="&version;" desc="&desc;" launch="&launchApp;" min="7.0.0" pluginURL="&pluginURL;" support="&repoURL;/issues" project="&repoURL;">
  <CHANGES>
{{CHANGES}}
  </CHANGES>
  <!--
    rclone-jobs: scheduled rclone/rsync jobs with a dry-run gate and native Unraid
    alerts (bell/email/Telegram/... via Settings -> Notification Settings). Runs
    alongside (never inside) the 'rclone' plugin by Waseh and reuses its
    config at /boot/config/plugins/rclone/.rclone.conf.
    Scheduling: marked block inside /var/spool/cron/crontabs/root (Unraid's Dillon cron
    does not read /etc/cron.d and never re-reads changed crontabs -> rc.crond restart
    on change only). All plugin state lives outside /mnt/user (dot-folder on an array
    disk). License: GPL-2.0-or-later. No phone-home: the plugin itself makes no
    outbound requests and stores no credentials; notifications go through the webGui
    notify script, whose agents (incl. Telegram) are configured by the user.
  -->
  <!-- UPDATE pre-clean: runs ONLY on plugin update (never on fresh install). Wipes the
       RAM-resident emhttp copy so files deleted between releases cannot linger as stale
       leftovers; the FILE blocks below re-deploy everything right after. Config on /boot
       and storage data are untouched. -->
  <FILE Run="/bin/bash" Method="update">
    <INLINE>
echo "----------------------------------------------------"
echo " rclone-jobs: update starting"
OLDV="$(grep -E 'ENTITY[[:space:]]+version' /var/log/plugins/&name;.plg 2>/dev/null | head -1 | cut -d'"' -f2)"
echo " previous version: ${OLDV:-unknown} -> new: &version;"
echo " preserving user configuration: &bootDir;"
JOB_COUNT="$(find "&bootDir;/jobs" -maxdepth 1 -name "*.conf" 2>/dev/null | wc -l)"
echo "   - jobs preserved: ${JOB_COUNT:-0} configuration(s)"
if [ -f "&bootDir;/paths.env" ]; then
  echo "   - settings preserved: &bootDir;/paths.env"
fi
echo " preserving storage data (logs, status, backups) on array"
echo " clearing previous emhttp copy: &pluginDir;"
rm -rf "&pluginDir;"
logger -t rclone-jobs "update: stale emhttp copy cleared (was ${OLDV:-unknown})"
echo " cleared. New files are re-deployed by the package manager below."
echo "----------------------------------------------------"
true
    </INLINE>
  </FILE>
  <!-- FILE entries are generated at build time from src/MANIFEST, each with a
       <SHA256> of the deployed (version-stamped) bytes: the plugin manager skips an
       existing destination file unless a supplied checksum fails, so the checksums are
       what make over-install/update actually REPLACE changed files. -->
{{FILES}}
  <!-- INSTALL: runs after the files above are in place, at install/upgrade AND at every
       boot (array may be down). Boot-safe and idempotent by design. -->
  <FILE Run="/bin/bash" Method="install">
    <INLINE>
echo "----------------------------------------------------"
if [ -e /var/log/plugins/&name;.plg ]; then RJ_MODE="update/repair"; else RJ_MODE="fresh install"; fi
echo " rclone-jobs v&version; - $RJ_MODE"
echo " emhttp copy: &pluginDir;"
echo "----------------------------------------------------"
S="&pluginDir;/scripts"
if [ -x "$S/boot-setup.sh" ]; then
  "$S/boot-setup.sh" --verbose
else
  mkdir -p "&bootDir;/jobs"
fi
echo "----------------------------------------------------"
echo " rclone-jobs v&version; - setup complete!"
echo " open: Settings -> Utilities -> rclone-jobs (details: syslog tag 'rclone-jobs')"
echo "----------------------------------------------------"
logger -t rclone-jobs "install script finished (v&version;, $RJ_MODE)"
true
    </INLINE>
  </FILE>
  <!-- REMOVE: stops running jobs, splices our block out of the root crontab, deletes
       the code. Deliberately KEEPS /boot config and all storage data (logs, status,
       backups, and a legacy notify.env if one exists) - delete those by hand if you
       want them gone. -->
  <FILE Run="/bin/bash" Method="remove">
    <INLINE>
echo "----------------------------------------------------"
echo " rclone-jobs v&version; - removing"
pkill -f 'rclone-jobs\.sh run ' 2>/dev/null
true
CT="/var/spool/cron/crontabs/root"
if grep -qF '# rclone-jobs BEGIN' "$CT" 2>/dev/null; then
  echo " splicing managed schedule block out of $CT and restarting cron"
  sed -i '/^# rclone-jobs BEGIN/,/^# rclone-jobs END/d' "$CT"
  if [ -x /etc/rc.d/rc.crond ]; then
    /etc/rc.d/rc.crond restart >/dev/null 2>&amp;1
  fi
else
  echo " no managed cron block present (nothing to splice)"
fi
rm -f /etc/cron.d/&name;
echo " deleting code: &pluginDir;"
rm -rf "&pluginDir;"
echo " KEPT on purpose: &bootDir; (your configs) and all storage data"
echo "   (logs, status, backups, legacy notify.env if present). Full cleanup by hand:"
echo "   rm -rf &bootDir; /mnt/diskN/.rclone-jobs"
logger -t rclone-jobs "&name; removed: code and schedule gone; &bootDir; and storage data kept on purpose"
echo "----------------------------------------------------"
true
    </INLINE>
  </FILE>
</PLUGIN>
