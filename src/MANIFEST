# rclone-jobs build manifest - single source of truth for build.ps1 AND build.sh.
# Format:  <src-rel-path> <whitespace> <absolute-target-path-on-Unraid> <whitespace> <octal-mode>
# '#' starts a comment. Every file under src/engine, src/emhttp, src/jobs MUST appear
# here (offline-lint enforces this two-way). Target prefix must be
# /usr/local/emhttp/plugins/rclone-jobs/
#
# Populated from Phase 1 onward. Example of the final shape:
#   engine/rclone-jobs.sh /usr/local/emhttp/plugins/rclone-jobs/engine/rclone-jobs.sh 0755
#   emhttp/index.php /usr/local/emhttp/plugins/rclone-jobs/index.php 0644
engine/rclone-jobs.sh /usr/local/emhttp/plugins/rclone-jobs/engine/rclone-jobs.sh 0755
emhttp/preview.php /usr/local/emhttp/plugins/rclone-jobs/preview.php 0644
emhttp/scripts/regen-cron.sh /usr/local/emhttp/plugins/rclone-jobs/scripts/regen-cron.sh 0755
emhttp/scripts/install-engine.sh /usr/local/emhttp/plugins/rclone-jobs/scripts/install-engine.sh 0755
emhttp/event/installed /usr/local/emhttp/plugins/rclone-jobs/event/installed 0755
emhttp/event/updating /usr/local/emhttp/plugins/rclone-jobs/event/updating 0755
emhttp/event/array_started /usr/local/emhttp/plugins/rclone-jobs/event/array_started 0755
emhttp/event/uninstalling /usr/local/emhttp/plugins/rclone-jobs/event/uninstalling 0755
