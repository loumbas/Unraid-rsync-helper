   Rendered server-side; all mutations go through ajax.php (CSRF-checked). */
$RJ_PLUGIN = '/usr/local/emhttp/plugins/rclone-jobs';
$RJ_BOOT   = '/boot/config/plugins/rclone-jobs';
$RJ_ENGINE = $RJ_PLUGIN.'/engine/rclone-jobs.sh';

$csrf_token = $csrf_token ?? (parse_ini_file('/var/local/emhttp/var.ini')['csrf_token'] ?? '');

function rj_read_env($file) {
    $out = [];
    if (!is_readable($file)) return $out;
    foreach (file($file, FILE_IGNORE_NEW_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#' || strpos($line, '=') === false) continue;
        list($k, $v) = explode('=', $line, 2);
        $out[trim($k)] = trim($v, " \t\"");
    }
    return $out;
}
function rj_json($file) {
    if (!is_readable($file)) return null;
    $d = json_decode(file_get_contents($file), true);
    return is_array($d) ? $d : null;
}

$paths    = rj_read_env($RJ_BOOT.'/paths.env');
$storage  = $paths['STORAGE_ROOT'] ?? '';
if ($storage === '') {
    /* auto-detect: first /mnt/diskN on /dev/md* */
    foreach (glob('/mnt/disk[0-9]*') as $d) {
        $src = trim((string)@shell_exec('findmnt -no SOURCE -T ' . escapeshellarg($d) . ' 2>/dev/null'));
        if (strpos($src, '/dev/md') === 0) { $storage = $d.'/.rclone-jobs'; break; }
    }
}
$master   = $paths['DRY_RUN_MASTER'] ?? 'yes';
$quietSt  = $paths['QUIET_START'] ?? '23:00';
$quietEn  = $paths['QUIET_END'] ?? '07:00';

$jobs = [];
foreach (glob($RJ_BOOT.'/jobs/*.conf') as $cf) {
    $name = basename($cf, '.conf');
    if (!preg_match('/^[A-Za-z0-9_-]{1,40}$/', $name)) continue;
    $cfg  = rj_read_env($cf);
    $st   = rj_json($storage.'/status/'.$name.'.json');
    $dry  = rj_json($storage.'/status/'.$name.'-dryrun.json');
    $jobs[$name] = ['conf' => $cfg, 'status' => $st, 'dryrun' => $dry];
}

$rjdata = [
    'version'    => '{{VERSION}}',
    'storage'    => $storage,
    'master'     => $master,
    'quiet'      => ['start' => $quietSt, 'end' => $quietEn],
    'jobs'       => $jobs,
];
?>
