<?php
/* rclone-jobs v{{VERSION}} - WebUI page (Settings tab).
   Rendered server-side; all mutations go through ajax.php (CSRF-checked). */
$RJ_PLUGIN = '/usr/local/emhttp/plugins/rclone-jobs';
$RJ_BOOT   = '/boot/config/plugins/rclone-jobs';
$RJ_ENGINE = $RJ_PLUGIN.'/engine/rclone-jobs.sh';

$csrf_token = $csrf_token ?? (parse_ini_file('/var/local/emhttp/var.ini')['csrf_token'] ?? '');

function rj_read_env($file) {
    $out = [];
    if (!is_readable($file)) return $out;
    foreach (file($file, FILE_IGNORE_NEW_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#' || strpos($line, '=') === false) continue;
        list($k, $v) = explode('=', $line, 2);
        $out[trim($k)] = trim($v, " \t\"");
    }
    return $out;
}
function rj_json($file) {
    if (!is_readable($file)) return null;
    $d = json_decode(file_get_contents($file), true);
    return is_array($d) ? $d : null;
}

$paths    = rj_read_env($RJ_BOOT.'/paths.env');
$storage  = $paths['STORAGE_ROOT'] ?? '';
if ($storage === '') {
    /* auto-detect: first /mnt/diskN on /dev/md* */
    foreach (glob('/mnt/disk[0-9]*') as $d) {
        $src = trim((string)@shell_exec('findmnt -no SOURCE -T ' . escapeshellarg($d) . ' 2>/dev/null'));
        if (strpos($src, '/dev/md') === 0) { $storage = $d.'/.rclone-jobs'; break; }
    }
}
$notify   = rj_read_env($storage.'/notify.env');
$master   = $paths['DRY_RUN_MASTER'] ?? 'yes';
$quietSt  = $paths['QUIET_START'] ?? '23:00';
$quietEn  = $paths['QUIET_END'] ?? '07:00';

$jobs = [];
foreach (glob($RJ_BOOT.'/jobs/*.conf') as $cf) {
    $name = basename($cf, '.conf');
    if (!preg_match('/^[A-Za-z0-9_-]{1,40}$/', $name)) continue;
    $cfg  = rj_read_env($cf);
    $st   = rj_json($storage.'/status/'.$name.'.json');
    $dry  = rj_json($storage.'/status/'.$name.'-dryrun.json');
    $jobs[$name] = ['conf' => $cfg, 'status' => $st, 'dryrun' => $dry];
}

$rjdata = [
    'version'    => '{{VERSION}}',
    'storage'    => $storage,
    'master'     => $master,
    'quiet'      => ['start' => $quietSt, 'end' => $quietEn],
    'telegram'   => ['enabled' => $notify['TG_ENABLED'] ?? 'no',
                     'chat_id' => $notify['TG_CHAT_ID'] ?? '',
                     'token_set' => !empty($notify['TG_TOKEN'] ?? '')],
    'jobs'       => $jobs,
];
?>
<style>
  /* native dl/dt/dd layout does the sizing; these only keep wide fields safe */
  #tab_rj_jobs input[type=text], #tab_rj_alerts input[type=text],
  #tab_rj_alerts input[type=password] { box-sizing:border-box; max-width:100%; }
  #tab_rj_jobs input.rj-path { width:520px; }
  #tab_rj_jobs table.rclone-jobs { width:100%; }
  #tab_rj_jobs td { word-break:break-word; }
  #tab_rj_jobs td [data-act] { white-space:nowrap; }
</style>
<script>var rj_csrf = <?= json_encode($csrf_token) ?>;</script>
<script src="/plugins/rclone-jobs/js/rclone-jobs.js?v={{VERSION}}"></script>
<?php /* script content is RAW TEXT: entities are never decoded there, so the JSON
         goes out unescaped but with < > & ' " hex-escaped (no </script> breakout). */ ?>
<script type="application/json" id="rj-data"><?= json_encode($rjdata, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?></script>

<ul class="tabs">
  <li><a href="#tab_rj_jobs">Jobs</a></li>
  <li><a href="#tab_rj_alerts">Alerts &amp; Safety</a></li>
  <li><a href="#tab_rj_doctor">Doctor</a></li>
</ul>

  <!-- ======================= JOBS TAB ======================= -->
  <div id="tab_rj_jobs">
    <table class="rclone-jobs view-table">
      <thead><tr>
        <th>Job</th><th>Enabled</th><th>Schedule</th><th>Engine</th>
        <th>Source → Destination</th><th>Last run</th><th>Last OK</th><th>Last dry-run</th><th>Actions</th>
      </tr></thead>
      <tbody>
      <?php if (count($jobs) === 0): ?>
        <tr><td colspan="9" style="text-align:center;padding:14px">No jobs yet - use "Add job" below.</td></tr>
      <?php endif; ?>
      <?php foreach ($jobs as $name => $j):
          $c = $j['conf']; $s = $j['status']; $d = $j['dryrun'];
          $en = ($c['ENABLED'] ?? 'yes') === 'no' ? 'no' : 'yes';
          $rc = $s ? ($s['running'] ?? false ? 'RUN' : ($s['rc'] ?? '-')) : '-';
          $run = $s['run'] ?? '-';
          $lastok = $s['last_ok_run'] ?? 'never';
          $drysum = '-';
          if ($d) {
              $drysum = ($d['stamp'] ?? '?')." copy+".($d['copies'] ?? 0)." del-".($d['deletes'] ?? 0)." fail:".($d['fails'] ?? 0);
              if (!empty($d['ack_blocked'])) $drysum .= " [NEEDS ACK]";
          }
          $needAck = $d && empty($d['ok']) && ($d['deletes'] ?? 0) > 0;
      ?>
        <tr data-job="<?= htmlspecialchars($name) ?>">
          <td><b><?= htmlspecialchars($name) ?></b><br><span class="gray"><?= htmlspecialchars($c['DESC'] ?? '') ?></span></td>
          <td><?= $en ?></td>
          <td><?= htmlspecialchars($c['SCHEDULE'] ?? '(none)') ?></td>
          <td><?= htmlspecialchars(($c['ENGINE'] ?? '?').(($c['MODE'] ?? '') !== '' ? '/'.$c['MODE'] : '')) ?></td>
          <!-- max-width must sit on a div: <td> ignores it in auto table layout -->
          <td><div style="max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<?= htmlspecialchars(($c['SRC'] ?? '').' -> '.($c['DST'] ?? '')) ?>">
            <?= htmlspecialchars($c['SRC'] ?? '') ?> → <?= htmlspecialchars($c['DST'] ?? '') ?></div></td>
          <td><?= htmlspecialchars((string)$rc) ?><?= $run !== '-' ? " (".htmlspecialchars((string)($s['secs'] ?? '?'))."s)" : '' ?></td>
          <td><?= htmlspecialchars((string)$lastok) ?></td>
          <td><?= htmlspecialchars($drysum) ?></td>
          <td style="white-space:nowrap">
            <input type='button' value='Dry-run' class='rj-btn' data-act='dry' data-job='<?= htmlspecialchars($name) ?>'>
            <input type='button' value='Run' class='rj-btn' data-act='run' data-job='<?= htmlspecialchars($name) ?>'>
            <?php if ($needAck): ?><input type='button' value='Ack' class='rj-btn rj-warn' data-act='ack' data-job='<?= htmlspecialchars($name) ?>'><?php endif; ?>
            <input type='button' value='Edit' class='rj-btn' data-act='edit' data-job='<?= htmlspecialchars($name) ?>'>
            <input type='button' value='Del' class='rj-btn rj-del' data-act='del' data-job='<?= htmlspecialchars($name) ?>'>
          </td>
        </tr>
      <?php endforeach; ?>
      </tbody>
    </table>
    <div id="rj-result" style="display:none;margin-top:10px"><pre id="rj-result-pre" style="white-space:pre-wrap"></pre></div>
    <div id="rj-preview" style="display:none;margin-top:10px"><pre id="rj-preview-pre" style="white-space:pre-wrap"></pre></div>

    <fieldset style="margin-top:14px"><legend id="rj-form-title">Add job</legend>
      <form id="rj-jobform" autocomplete="off">
        <input type="hidden" id="f_orig" value="">
        <dl><dt>Name:</dt><dd><input type="text" id="f_name" maxlength="40" pattern="[A-Za-z0-9_-]{1,40}" required></dd></dl>
        <blockquote class='inline_help'><p>Unique job id - letters, digits, dash and underscore, max 40 characters. It names the config file and the schedule entry, so it cannot be changed afterwards; to rename a job create a new one and delete the old.</p></blockquote>
        <dl><dt>Description:</dt><dd><input type="text" id="f_desc" maxlength="120"></dd></dl>
        <blockquote class='inline_help'><p>Free-text label shown under the job name in the jobs table.</p></blockquote>
        <dl><dt>Enabled:</dt><dd><select id="f_enabled"><option value="yes">yes</option><option value="no">no</option></select></dd></dl>
        <blockquote class='inline_help'><p>A disabled job keeps its configuration and history but gets no schedule line. Manual Dry-run/Run buttons still work on disabled jobs.</p></blockquote>
        <dl><dt>Schedule (cron):</dt><dd><input type="text" id="f_schedule" size="24" placeholder="30 3 * * *"></dd></dl>
        <blockquote class='inline_help'><p>Five fields: <em>minute hour day-of-month month day-of-week</em>. Only numbers, <em>*</em> and the characters <em>,</em> <em>-</em> <em>/</em> are accepted, e.g. <em>30 3 * * *</em> = every day at 03:30, <em>0 5 * * 6</em> = Saturday 05:00.</p></blockquote>
        <dl><dt>Engine:</dt><dd><select id="f_engine"><option value="rclone">rclone</option><option value="rsync">rsync</option><option value="custom">custom script</option></select></dd></dl>
        <blockquote class='inline_help'><p><em>rclone</em> uses the rclone plugin's own remotes (same config, never modified). <em>rsync</em> is for local/remote paths with mount-guard protection. <em>custom script</em> runs your own executable instead - the transfer settings below do not apply to it.</p></blockquote>
        <div class="rj-eng">
        <dl><dt>Mode (rclone):</dt><dd><select id="f_mode"><option value="sync">sync</option><option value="copy">copy</option><option value="check">check</option></select></dd></dl>
        <blockquote class='inline_help'><p><em>sync</em> makes destination identical to source (may delete). <em>copy</em> only adds/updates, never deletes. <em>check</em> only compares and reports differences.</p></blockquote>
        <dl><dt>Source:</dt><dd><input type="text" id="f_src" class="rj-path" placeholder="/mnt/user/data or remote:bucket/folder"> <input type="button" value="Browse..." class="rj-btn rj-browse-btn" data-target="f_src"></dd></dl>
        <blockquote class='inline_help'><p>Folder on this server (shares, array disks, mounts) or an rclone remote path like <em>gdrive:Data</em>. Use Browse... to pick it; typing a not-yet-existing remote folder is allowed. The run refuses (with an alert) if a local source does not exist.</p></blockquote>
        <dl><dt>Destination:</dt><dd><input type="text" id="f_dst" class="rj-path" placeholder="remote:backup/folder or /mnt/disk2/mirror"> <input type="button" value="Browse..." class="rj-btn rj-browse-btn" data-target="f_dst"></dd></dl>
        <blockquote class='inline_help'><p>Where files land. A local destination must already be a mounted directory - it is never auto-created, so an unmounted array/share is refused instead of filling RAM. New folders inside a valid destination are created by the engine.</p></blockquote>
        </div>
        <div class="rj-custom" style="display:none">
        <dl><dt>Script:</dt><dd><input type="text" id="f_script" class="rj-path" placeholder="/usr/local/emhttp/plugins/rclone-jobs/scripts/my-script.sh"> <input type="button" value="Browse..." class="rj-btn rj-browse-btn" data-target="f_script"></dd></dl>
        <blockquote class='inline_help'><p>Absolute path of an executable script; Browse... shows <em>.sh</em> files under the plugins folder. The script runs as root with a hardened PATH; its exit code and output go into the job status and logs.</p></blockquote>
        </div>
        <dl><dt>Per-job dry-run:</dt><dd><select id="f_dryrun"><option value="yes">yes (preview only)</option><option value="no">no (real transfer)</option></select></dd></dl>
        <blockquote class='inline_help'><p>While <em>yes</em>, scheduled runs only simulate. The master switch on the Alerts and Safety tab always wins: when it is ON, every scheduled run is a dry-run regardless of this setting.</p></blockquote>
        <div class="rj-eng">
        <dl><dt>Transfers / Checkers:</dt><dd><input type="number" id="f_transfers" min="1" max="999" value="4"> / <input type="number" id="f_checkers" min="1" max="999" value="8"></dd></dl>
        <blockquote class='inline_help'><p>rclone parallelism: simultaneous file transfers and hash-check workers. Raise for many small files; lower on weak links.</p></blockquote>
        <dl><dt>Bandwidth limit:</dt><dd><input type="text" id="f_bwlimit" size="10" placeholder="off"></dd></dl>
        <blockquote class='inline_help'><p>rclone syntax, e.g. <em>10M</em> (10 MByte/s) or <em>off</em> for unlimited. Only affects the rclone engine.</p></blockquote>
        <dl><dt>Max deletes / Warn deletes:</dt><dd><input type="number" id="f_maxdelete" min="0" max="999999999" value="100"> / <input type="number" id="f_warndelete" min="0" max="999999999" value="100"></dd></dl>
        <blockquote class='inline_help'><p>Sync modes only. <em>Max deletes</em> is a hard cap - rclone aborts rather than deleting more. <em>Warn deletes</em> makes a dry-run that wants to delete more of this many require an explicit Ack before a real run is allowed.</p></blockquote>
        <dl><dt>Backup dir (optional):</dt><dd><input type="text" id="f_backupdir" class="rj-path" placeholder="remote:trash or STORAGE_ROOT subfolder - before-delete copy"> <input type="button" value="Browse..." class="rj-btn rj-browse-btn" data-target="f_backupdir"></dd></dl>
        <blockquote class='inline_help'><p>rclone <em>--backup-dir</em>: files that would be deleted or overwritten are moved here first instead of disappearing. A remote like <em>gdrive:trash</em> or a subfolder of the storage folder work well; leave empty to disable.</p></blockquote>
        </div>
        <p>
          <input type="submit" value="Save job" class="rj-btn">
          <input type="button" id="rj-form-cancel" value="Cancel">
        </p>
      </form>
    </fieldset>
