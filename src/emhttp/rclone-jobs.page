      <?php foreach ($jobs as $name => $j):
          $c = $j['conf']; $s = $j['status']; $d = $j['dryrun'];
          $en = ($c['ENABLED'] ?? 'yes') === 'no' ? 'no' : 'yes';
          $dryMode = ($c['DRYRUN'] ?? 'yes') === 'no' ? 'no' : 'yes';
          $running = !empty($s['running']);
          $rc = $s['rc'] ?? null;
          $rcTxt = $running ? 'RUN' : (($rc === null || $rc === '') ? '-' : (string)$rc);
          $run = $s['run'] ?? '-';
          $lastok = $s['last_ok_run'] ?? 'never';
          $dryshort = '-'; $dryfull = '';
          $needAck = false;
          if ($d) {
              $ts = (string)($d['stamp'] ?? '?');
              $dts = strlen($ts) >= 16 ? substr($ts, 5, 5).' '.substr($ts, 11, 5) : $ts;
              $dryfull = $ts.' copy+'.($d['copies'] ?? 0).' del-'.($d['deletes'] ?? 0).' fail:'.($d['fails'] ?? 0);
              $dryshort = $dts.' +'.($d['copies'] ?? 0).' -'.($d['deletes'] ?? 0).' !'.($d['fails'] ?? 0);
              /* same rule as the engine's gate_check: deletions over the job's
                 WARN_DELETE threshold stay blocked for live runs until acked */
              $warn = isset($d['warnDelete']) ? (int)$d['warnDelete'] : (int)($c['WARN_DELETE'] ?? 0);
              $needAck = ($d['deletes'] ?? 0) > $warn && empty($d['ack']);
          }
          $ok = !$running && preg_match('/^(0|24)$/', (string)$rc) && $rc !== null && $rc !== '';
          $rcDisplay = $rcTxt;
          if ($ok && ((string)$rc === '0' || $rc === 0)) {
              $rcDisplay = 'OK';
          }
          /* row cue priority: running > needs-ack > ok / failed; disabled only dims */
          if ($running)     $stCls = 'rj-st-run';
          elseif ($needAck) $stCls = 'rj-st-ack';
          elseif ($ok)      $stCls = 'rj-st-ok';
          elseif ($rcTxt !== '-' && $rcTxt !== 'RUN') $stCls = 'rj-st-bad';
          else              $stCls = '';
          if ($en === 'no') $stCls .= ' rj-off';
      ?>
        <tr data-job="<?= htmlspecialchars($name) ?>" class="rj-row <?= $stCls ?>">
          <td class="rj-col-job">
            <div style="font-weight:600;font-size:13px;color:var(--text,#e8eef3)"><?= htmlspecialchars($name) ?></div>
            <span class="rj-chip <?= strtolower($c['ENGINE'] ?? 'rclone') ?>"><?= htmlspecialchars(($c['ENGINE'] ?? '?').(($c['MODE'] ?? '') !== '' ? '/'.$c['MODE'] : '')) ?></span>
            <?php if (($c['DESC'] ?? '') !== ''): ?><br><span class="gray"><?= htmlspecialchars($c['DESC']) ?></span><?php endif; ?>
          </td>
          <td class="rj-col-toggle" style="white-space:nowrap">
            <label class="rj-switch" title="Click to <?= $en === 'yes' ? 'disable' : 'enable' ?> job">
              <input type="checkbox" class="rj-toggle-en" data-job="<?= htmlspecialchars($name) ?>" <?= $en === 'yes' ? 'checked' : '' ?>>
              <span class="rj-slider"></span>
            </label>
            <span class="rj-switch-text <?= $en === 'yes' ? 'on' : 'off' ?>"><?= $en === 'yes' ? 'ON' : 'OFF' ?></span>
          </td>
          <td class="rj-col-toggle rj-col-dry" style="white-space:nowrap">
            <label class="rj-switch" title="Dry-run <?= $dryMode === 'yes' ? 'active (simulated)' : 'inactive (live transfers)' ?> - click to toggle">
              <input type="checkbox" class="rj-toggle-dry" data-job="<?= htmlspecialchars($name) ?>" <?= $dryMode === 'yes' ? 'checked' : '' ?>>
              <span class="rj-slider rj-slider-dry"></span>
            </label>
            <span class="rj-switch-text rj-dry-text <?= $dryMode === 'yes' ? 'dry' : 'live' ?>"><?= $dryMode === 'yes' ? 'DRY' : 'LIVE' ?></span>
          </td>
          <td class="rj-sched"><?= htmlspecialchars($c['SCHEDULE'] ?? '(none)') ?></td>
          <?php
            $src = $c['SRC'] ?? '';
            $dst = $c['DST'] ?? '';
            $srcIsRemote = strpos($src, ':') !== false;
            $dstIsRemote = strpos($dst, ':') !== false;
          ?>
          <td class="rj-col-paths">
            <div class="rj-path-container" title="<?= htmlspecialchars($src.' -> '.$dst) ?>">
              <span class="rj-path-endpoint"><i class="fa <?= $srcIsRemote ? 'fa-cloud' : 'fa-folder' ?>" style="color:<?= $srcIsRemote ? '#5cacee' : '#e5c07b' ?>"></i><span class="rj-path-text" title="<?= htmlspecialchars($src) ?>"><?= htmlspecialchars($src) ?></span></span>
              <i class="fa fa-arrow-right rj-path-arrow"></i>
              <span class="rj-path-endpoint"><i class="fa <?= $dstIsRemote ? 'fa-cloud' : 'fa-folder' ?>" style="color:<?= $dstIsRemote ? '#5cacee' : '#e5c07b' ?>"></i><span class="rj-path-text" title="<?= htmlspecialchars($dst) ?>"><?= htmlspecialchars($dst) ?></span></span>
            </div>
          </td>
          <td class="rj-col-lastrun" style="white-space:nowrap">
            <?php
              $trAmt = $s['transferred'] ?? '';
              $hasTr = ($trAmt !== '' && $trAmt !== '0' && $trAmt !== '0 B');
            ?>
            <span class="rj-rc<?= $ok ? ' ok' : (($rcTxt !== '-' && $rcTxt !== 'RUN') ? ' bad' : ($running ? ' run' : '')) ?>">
              <?php if ($ok): ?><i class="fa fa-check-circle"></i> <?php elseif ($running): ?><i class="fa fa-refresh fa-spin"></i> <?php elseif ($rcTxt !== '-'): ?><i class="fa fa-times-circle"></i> <?php endif; ?>
              <?= htmlspecialchars($rcDisplay) ?><?= $run !== '-' ? " (".htmlspecialchars((string)($s['secs'] ?? '?'))."s".($hasTr ? " · ".htmlspecialchars($trAmt) : '').")" : '' ?>
            </span>
            <br><span class="rj-lastok">last OK: <?= htmlspecialchars((string)$lastok) ?></span>
          </td>
          <td class="rj-dry"<?= $dryfull !== '' ? ' title="'.htmlspecialchars($dryfull).'"' : '' ?>>
            <?php if ($d): ?>
              <span class="rj-dry-ts"><?= htmlspecialchars($dts) ?></span>
              <span class="rj-chip-diff rj-chip-add" title="Files copied/added">+<?= (int)($d['copies'] ?? 0) ?></span>
              <span class="rj-chip-diff rj-chip-del" title="Files deleted">-<?= (int)($d['deletes'] ?? 0) ?></span>
              <span class="rj-chip-diff rj-chip-err" title="Errors">!<?= (int)($d['fails'] ?? 0) ?></span>
              <?php if ($needAck): ?><span class="rj-needsack">needs ack</span><?php endif; ?>
            <?php else: ?>
              -
            <?php endif; ?>
          </td>
          <td class="rj-acts">
            <div class="rj-acts-wrap">
              <span class="rj-act-grp">
                <button type="button" class="rj-btn" data-act="dry" data-job="<?= htmlspecialchars($name) ?>" title="Dry-run: simulate only, nothing is written"><i class="fa fa-flask"></i><span class="rj-btn-lbl"> Dry</span></button>
                <button type="button" class="rj-btn" data-act="run" data-job="<?= htmlspecialchars($name) ?>" title="Start a run now (respects the master dry-run switch)"<?= $running ? " style='display:none'" : '' ?>><i class="fa fa-play"></i><span class="rj-btn-lbl"> Run</span></button>
                <button type="button" class="rj-btn rj-del" data-act="stop" data-job="<?= htmlspecialchars($name) ?>" title="Stop the live run (interrupts the transfer; recorded as rc=143, next run resumes)"<?= $running ? '' : " style='display:none'" ?>><i class="fa fa-stop"></i><span class="rj-btn-lbl"> Stop</span></button>
                <?php if ($needAck): ?><button type="button" class="rj-btn rj-warn" data-act="ack" data-job="<?= htmlspecialchars($name) ?>" title="This dry-run wants to delete files - acknowledge before a real run"><i class="fa fa-exclamation-triangle"></i><span class="rj-btn-lbl"> Ack</span></button><?php endif; ?>
              </span>
              <span class="rj-act-sep"></span>
              <span class="rj-act-grp">
                <button type="button" class="rj-btn" data-act="log" data-job="<?= htmlspecialchars($name) ?>" title="Open the last log (redacted) in a new window"><i class="fa fa-file-text-o"></i><span class="rj-btn-lbl"> Log</span></button>
                <button type="button" class="rj-btn" data-act="hist" data-job="<?= htmlspecialchars($name) ?>" title="Last 20 live runs + size trend"><i class="fa fa-history"></i><span class="rj-btn-lbl"> Hist</span></button>
              </span>
              <span class="rj-act-sep"></span>
              <span class="rj-act-grp">
                <button type="button" class="rj-btn" data-act="edit" data-job="<?= htmlspecialchars($name) ?>" title="Edit this job"><i class="fa fa-pencil"></i><span class="rj-btn-lbl"> Edit</span></button>
                <button type="button" class="rj-btn rj-del" data-act="del" data-job="<?= htmlspecialchars($name) ?>" title="Delete this job (config kept as a .removed-* backup)"><i class="fa fa-trash"></i></button>
              </span>
            </div>
          </td>
        </tr>
      <?php endforeach; ?>
      </tbody>
    </table>
