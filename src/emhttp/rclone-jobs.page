          $running = !empty($s['running']);
          $rc = $s['rc'] ?? null;
          $rcTxt = $running ? 'RUN' : (($rc === null || $rc === '') ? '-' : (string)$rc);
          $run = $s['run'] ?? '-';
          $lastok = $s['last_ok_run'] ?? 'never';
          $dryshort = '-'; $dryfull = '';
          $needAck = false;
          if ($d) {
              $ts = (string)($d['stamp'] ?? '?');
              $dts = strlen($ts) >= 16 ? substr($ts, 5, 5).' '.substr($ts, 11, 5) : $ts;
              $dryfull = $ts.' copy+'.($d['copies'] ?? 0).' del-'.($d['deletes'] ?? 0).' fail:'.($d['fails'] ?? 0);
              $dryshort = $dts.' +'.($d['copies'] ?? 0).' -'.($d['deletes'] ?? 0).' !'.($d['fails'] ?? 0);
              /* same rule as the engine's gate_check: deletions over the job's
                 WARN_DELETE threshold stay blocked for live runs until acked */
              $warn = isset($d['warnDelete']) ? (int)$d['warnDelete'] : (int)($c['WARN_DELETE'] ?? 0);
              $needAck = ($d['deletes'] ?? 0) > $warn && empty($d['ack']);
          }
          $ok = !$running && preg_match('/^(0|24)$/', (string)$rc) && $rc !== null && $rc !== '';
          /* row cue priority: running > needs-ack > ok / failed; disabled only dims */
          if ($running)     $stCls = 'rj-st-run';
          elseif ($needAck) $stCls = 'rj-st-ack';
          elseif ($ok)      $stCls = 'rj-st-ok';
          elseif ($rcTxt !== '-' && $rcTxt !== 'RUN') $stCls = 'rj-st-bad';
          else              $stCls = '';
          if ($en === 'no') $stCls .= ' rj-off';
