  <FILE Name="/usr/local/emhttp/plugins/rclone-jobs/preview.php" Mode="0644">
<INLINE>
&lt;?php
/*
 * rclone-jobs preview renderer - turns rclone/rsync dry-run logs into a
 * structured report (JSON for status/&lt;job&gt;-dryrun.json, text for humans).
 * Used by the engine via PHP CLI only (the WebUI reads the JSON it produces).
 *
 * License: GPL-2.0-or-later. PHP 8.x clean.
 * CLI: preview.php --mode json|text [--engine rclone|rsync] [--rc N]
 *                   [--empty-dest yes|no] &lt;logfile&gt;
 */

function rj_preview_parse(string $file, string $engine): array
{
    $r = ['copies' =&gt; 0, 'news' =&gt; 0, 'updates' =&gt; 0, 'skips' =&gt; 0, 'deletes' =&gt; 0,
          'fails' =&gt; 0, 'other' =&gt; 0, 'bytes' =&gt; '', 'delete_samples' =&gt; [],
          'fail_samples' =&gt; [], 'emptyDest' =&gt; false, 'fatal' =&gt; '', 'ok' =&gt; false];
    if (!is_readable($file)) {
        $r['fatal'] = 'dry-run log not readable';
        return $r;
    }
    $fp = fopen($file, 'r');
    if ($fp === false) {
        $r['fatal'] = 'dry-run log could not be opened';
        return $r;
    }
    $newsDbg = 0; $deletesSum = -1; $copiesSum = -1; $skipsSum = -1;
    $transBytesRe = '/^\s*Transferred:\s+([0-9.]+ ?(?:[KMGTPE]i?)?B)/i';
    $transFilesRe = '/^\s*Transferred:\s+(\d+) \/ (\d+)/';
    $deletedSumRe = '/^\s*Deleted:\s+(\d+) \(files\)/';
    $checksRe     = '/^\s*Checks:\s+(\d+) \/ \d+/';
    while (($line = fgets($fp)) !== false) {
        $line = rtrim($line, "\r\n");
        if ($engine === 'rsync') {
            if (preg_match('/^(deleting |\*deleting\b)/', $line)) {
                $r['deletes']++;
                if (count($r['delete_samples']) &lt; 25) { $r['delete_samples'][] = substr(trim(substr($line, strlen('deleting '))), 0, 300); }
            } elseif (preg_match('/^[&lt;&gt;.chLpgoatD*+.][f.dD][c^+][sA-Za-z.][i.][x+.][pP][oO][gG][tTuU]/', $line)) {
                if (str_starts_with($line, '&lt;f+++++++++')) { $r['copies']++; $r['news']++; }
                elseif ($line[0] === '&lt;')                 { $r['copies']++; $r['updates']++; }
                elseif ($line[0] === '.')                 { $r['skips']++; }
                else                                      { $r['other']++; }
            } elseif (preg_match('/ERROR/i', $line)) {
                $r['fails']++;
                if (count($r['fail_samples']) &lt; 10) { $r['fail_samples'][] = substr($line, 0, 300); }
            } elseif (preg_match($transBytesRe, $line, $m)) {
                $r['bytes'] = trim($m[1]);
            }
            continue;
        }
        // rclone - markers verified against REAL v1.75.0 '-vv --dry-run' output:
        //   NOTICE: &lt;file&gt;: Skipped copy as --dry-run is set (size N)
        //   NOTICE: &lt;file&gt;: Skipped delete as --dry-run is set (size N)
        //   summary: Transferred:/Deleted: N (files)/Checks: lines at column 0
        if (preg_match('/^\s*Transferred:\s+[0-9.]+ ?(?:[KMGTPE]i?)?B/', $line)) {
            if ($r['bytes'] === '' &amp;&amp; preg_match($transBytesRe, $line, $m)) { $r['bytes'] = trim($m[1]); }
        } elseif (preg_match($transFilesRe, $line, $m)) {
            $copiesSum = (int)$m[2];
        } elseif (preg_match($deletedSumRe, $line, $m)) {
            $deletesSum = (int)$m[1];
        } elseif (preg_match($checksRe, $line, $m)) {
            $skipsSum = (int)$m[1];
        } elseif (preg_match('/ ERROR /', $line)) {
            $r['fails']++;
            if (count($r['fail_samples']) &lt; 10) { $r['fail_samples'][] = substr($line, 0, 300); }
        } elseif (preg_match("/Can't copy/i", $line)) {
            $r['fails']++;
            if (count($r['fail_samples']) &lt; 10) { $r['fail_samples'][] = substr($line, 0, 300); }
        } elseif (preg_match('/NOTICE: (.+?): Skipped delete as --dry-run/i', $line, $m)) {
            $r['deletes']++;
            if (count($r['delete_samples']) &lt; 25) { $r['delete_samples'][] = substr(trim($m[1]), 0, 300); }
        } elseif (preg_match('/Skipped (mkdir|delete dir|set directory)/i', $line)) {
            // directory bookkeeping - not a file operation, counted nowhere
        } elseif (preg_match('/NOTICE: .*: Skipped copy as --dry-run/i', $line)) {
            $r['copies']++;
        } elseif (preg_match('/File not found at Destination/', $line)) {
            $newsDbg++;
        } elseif (preg_match('/\bCopied\b/', $line)) {
            $r['copies']++;
            if (stripos($line, '(new)') !== false) { $r['news']++; } else { $r['updates']++; }
        } elseif ($line !== '') {
            $r['other']++;
        }
    }
    fclose($fp);
    // summary lines are authoritative when present
    if ($engine === 'rclone') {
        if ($deletesSum &gt;= 0) { $r['deletes'] = $deletesSum; }
        if ($copiesSum &gt;= 0 &amp;&amp; $r['copies'] === 0) { $r['copies'] = $copiesSum; }
        if ($skipsSum &gt;= 0)   { $r['skips'] = $skipsSum; }
        if ($r['news'] === 0 &amp;&amp; $newsDbg &gt; 0) { $r['news'] = $newsDbg; }
        if ($r['news'] &gt; $r['copies']) { $r['news'] = $r['copies']; }
        $r['updates'] = $r['copies'] - $r['news'];
    }
    // emptyDest is decided ONLY by the engine (--empty-dest: local destination
    // exists but is empty). A log-based heuristic would false-positive whenever
    // source and destination simply share no filenames.
    return $r;
}

function rj_preview_text(array $r, int $rc, bool $emptyDestArg): string
{
    $out = [];
    $out[] = 'DRY RUN - nothing was changed';
    $out[] = 'will copy     : ' . $r['copies'] . ($r['bytes'] !== '' ? '  (' . $r['bytes'] . ')' : '');
    $out[] = '  of which new: ' . $r['news'] . ', updates: ' . $r['updates'];
    $out[] = 'will skip     : ' . $r['skips'];
    $out[] = 'will DELETE   : ' . $r['deletes'];
    $out[] = 'will fail     : ' . $r['fails'] . '  (fix these before the real run)';
    $out[] = 'unparsed lines: ' . $r['other'];
    if ($r['deletes'] &gt; 0) {
        $out[] = '';
        $out[] = '--- deletions (max 25) ---';
        foreach ($r['delete_samples'] as $s) { $out[] = '  DELETE  ' . $s; }
    }
    if ($r['fails'] &gt; 0) {
        $out[] = '';
        $out[] = '--- will-fail samples ---';
        foreach ($r['fail_samples'] as $s) { $out[] = '  FAIL  ' . $s; }
    }
    if ($r['emptyDest'] || $emptyDestArg) {
        $out[] = '';
        $out[] = '*** WARNING: destination looks EMPTY or new - a live sync would now mirror the source onto it.';
        $out[] = '*** If the source is wrong or partially missing, this is exactly how destinations get wiped.';
        $out[] = '*** Check SRC and DST before ever running live.';
    }
    if ($rc !== 0) {
        $out[] = '';
        $out[] = '*** Dry-run exited with code ' . $rc . ' - treat the source/destination state as UNRELIABLE.';
    }
    return implode("\n", $out) . "\n";
}

if (PHP_SAPI === 'cli') {
    $mode = 'json'; $engine = 'rclone'; $rc = 0; $ed = false; $file = '';
    $argv0 = array_shift($argv);
    while (count($argv) &gt; 0) {
        $a = array_shift($argv);
        if ($a === '--mode')        { $mode = (string)array_shift($argv); }
        elseif ($a === '--engine')  { $engine = (string)array_shift($argv); }
        elseif ($a === '--rc')      { $rc = (int)array_shift($argv); }
        elseif ($a === '--empty-dest') { $ed = ((string)array_shift($argv)) === 'yes'; }
        else                        { $file = $a; }
    }
    if ($file === '' || !is_readable($file)) { fwrite(STDERR, "preview.php: unreadable log file\n"); exit(2); }
    $r = rj_preview_parse($file, $engine);
    $r['ok'] = ($rc === 0 &amp;&amp; $r['fails'] === 0 &amp;&amp; $r['fatal'] === '');
    $r['rc'] = $rc;
    $r['engine'] = $engine;
    if ($ed) { $r['emptyDest'] = true; }
    if ($mode === 'text') {
        echo rj_preview_text($r, $rc, $ed);
    } else {
        echo json_encode($r, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
    }
    exit(0);
}
</INLINE>
<SHA256>1e56c2bc57fbd1410adb79093d6d5050309c1056b30adef329f2a28e13e9f4bf</SHA256>
  </FILE>

  <FILE Name="/usr/local/emhttp/plugins/rclone-jobs/rclone-jobs.page" Mode="0644">
<INLINE>
Menu="Utilities"
Title="rclone-jobs"
Icon="rclone-jobs.png"
---
&lt;?php
/* rclone-jobs v2026.09.10e - WebUI page (Settings tab).
   Rendered server-side; all mutations go through ajax.php (CSRF-checked). */
$RJ_BOOT   = '/boot/config/plugins/rclone-jobs';

$csrf_token = $csrf_token ?? (parse_ini_file('/var/local/emhttp/var.ini')['csrf_token'] ?? '');

function rj_read_env($file) {
    $out = [];
    if (!is_readable($file)) return $out;
    foreach (file($file, FILE_IGNORE_NEW_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#' || strpos($line, '=') === false) continue;
        list($k, $v) = explode('=', $line, 2);
        $out[trim($k)] = trim($v, " \t\"");
    }
    return $out;
}
function rj_json($file) {
    if (!is_readable($file)) return null;
    $d = json_decode(file_get_contents($file), true);
    return is_array($d) ? $d : null;
}

$paths    = rj_read_env($RJ_BOOT.'/paths.env');
$storage  = $paths['STORAGE_ROOT'] ?? '';
if ($storage === '') {
    /* auto-detect: first /mnt/diskN on /dev/md* */
    foreach (glob('/mnt/disk[0-9]*') as $d) {
        $src = trim((string)@shell_exec('findmnt -no SOURCE -T ' . escapeshellarg($d) . ' 2&gt;/dev/null'));
        if (strpos($src, '/dev/md') === 0) { $storage = $d.'/.rclone-jobs'; break; }
    }
}
$master   = $paths['DRY_RUN_MASTER'] ?? 'yes';
$quietSt  = $paths['QUIET_START'] ?? '23:00';
$quietEn  = $paths['QUIET_END'] ?? '07:00';
function rj_ret($paths, $key, $def, $lo, $hi) {
    /* same defaults AND same clamps as the engine's load_paths()/num_clamp():
       a hand-edited paths.env value never reaches the fields as garbage */
    $v = $paths[$key] ?? '';
    if (!preg_match('/^\d{1,5}$/', $v)) return $def;
    return max($lo, min($hi, intval($v)));
}
$retention = [
    'rawHours'  =&gt; rj_ret($paths, 'HISTORY_RAW_HOURS', 24, 1, 168),
    'rawMax'    =&gt; rj_ret($paths, 'HISTORY_RAW_MAX', 500, 20, 5000),
    'hourDays'  =&gt; rj_ret($paths, 'HISTORY_HOUR_DAYS', 7, 1, 60),
    'days'      =&gt; rj_ret($paths, 'HISTORY_DAYS', 90, 7, 365),
    'logDays'   =&gt; rj_ret($paths, 'LOG_KEEP_DAYS', 3, 1, 90),
    'failDays'  =&gt; rj_ret($paths, 'LOG_KEEP_FAIL_DAYS', 14, 1, 90),
    'logMax'    =&gt; rj_ret($paths, 'LOG_KEEP_MAX', 300, 20, 20000),
];

$jobs = [];
foreach (glob($RJ_BOOT.'/jobs/*.conf') as $cf) {
    $name = basename($cf, '.conf');
    if (!preg_match('/^[A-Za-z0-9_-]{1,40}$/', $name)) continue;
    $cfg  = rj_read_env($cf);
    $st   = rj_json($storage.'/status/'.$name.'.json');
    $dry  = rj_json($storage.'/status/'.$name.'-dryrun.json');
    $jobs[$name] = ['conf' =&gt; $cfg, 'status' =&gt; $st, 'dryrun' =&gt; $dry];
}
$nEnabled = 0;
$nFailed  = 0;
foreach ($jobs as $jj) {
    if (($jj['conf']['ENABLED'] ?? 'yes') !== 'no') $nEnabled++;
    $rc = $jj['status']['rc'] ?? null;
    if ($rc !== null &amp;&amp; $rc !== '' &amp;&amp; (int)$rc !== 0 &amp;&amp; empty($jj['status']['running'])) $nFailed++;
}

function rj_to_bytes($s) {
    $s = trim((string)$s);
    if (!preg_match('/^([0-9.]+)\s*([KMGTPE]?i?B)?$/i', $s, $m)) return 0;
    $v = (float)$m[1];
    $u = strtoupper($m[2] ?? 'B');
    $mult = 1;
    if (strpos($u, 'K') === 0) $mult = 1024;
    elseif (strpos($u, 'M') === 0) $mult = 1048576;
    elseif (strpos($u, 'G') === 0) $mult = 1073741824;
    elseif (strpos($u, 'T') === 0) $mult = 1099511627776;
    return (float)($v * $mult);
}
function rj_parse_log_bytes($logfile) {
    if (!is_readable($logfile)) return 0;
    $fp = @fopen($logfile, 'r');
    if (!$fp) return 0;
    $stat = @fstat($fp);
    $size = $stat['size'] ?? 0;
    if ($size &gt; 32768) fseek($fp, $size - 32768);
    $data = fread($fp, 32768);
    fclose($fp);
    if (!$data) return 0;
    if (preg_match_all('/(?:INFO|NOTICE)\s*:\s+([0-9.]+ ?[KMGTPE]?i?B)\s*\//i', $data, $m)) {
        return rj_to_bytes(end($m[1]));
    }
    if (preg_match_all('/^\s*Transferred:\s+([0-9.]+ ?[KMGTPE]?i?B)/mi', $data, $m)) {
        return rj_to_bytes(end($m[1]));
    }
    return 0;
}

$bytes24 = 0;
$now = time();
foreach ($jobs as $name =&gt; $jj) {
    $histFile = $storage.'/history/'.$name.'.jsonl';
    if (is_readable($histFile)) {
        $lines = @file($histFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        if ($lines) {
            foreach ($lines as $ln) {
                $e = @json_decode($ln, true);
                if ($e &amp;&amp; isset($e['ts']) &amp;&amp; ($now - (int)$e['ts']) &lt;= 86400) {
                    $b = (float)($e['bytes'] ?? 0);
                    if ($b &lt;= 0 &amp;&amp; !empty($e['transferred']) &amp;&amp; $e['transferred'] !== '0' &amp;&amp; $e['transferred'] !== '0 B') {
                        $b = rj_to_bytes($e['transferred']);
                    }
                    if ($b &lt;= 0 &amp;&amp; !empty($e['log'])) {
                        $b = rj_parse_log_bytes($e['log']);
                    }
                    $bytes24 += $b;
                }
            }
        }
    } elseif (!empty($jj['status']['log']) &amp;&amp; !empty($jj['status']['last_ok']) &amp;&amp; ($now - (int)$jj['status']['last_ok']) &lt;= 86400) {
        $bytes24 += rj_parse_log_bytes($jj['status']['log']);
    }
}
function rj_fmt_bytes($b) {
    if ($b &lt;= 0) return '0 B';
    $u = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
    $i = 0;
    while ($b &gt;= 1024 &amp;&amp; $i &lt; 4) { $b /= 1024; $i++; }
    return ($i === 0 || $b &gt;= 100 ? round($b) : number_format($b, 1)).' '.$u[$i];
}
$b24Txt = rj_fmt_bytes($bytes24);

/* Hourly transfer statistics (last 16 hours) for the graph card */
$hourlySlots = [];
$peakBytes = 1;
$statTotalRuns = 0;
$statLastRun = '-';
$statSecsSum = 0;
$statBytesSum = 0;

for ($i = 15; $i &gt;= 0; $i--) {
    $hTs = strtotime("-$i hours");
    $hKey = date('Y-m-d H:00', $hTs);
    $hLabel = date('H', $hTs);
    $hourlySlots[$hKey] = [
        'label' =&gt; $hLabel,
        'bytes' =&gt; 0,
        'runs'  =&gt; 0,
        'fails' =&gt; 0,
        'secs'  =&gt; 0,
        'title' =&gt; date('M j, H:00', $hTs)
    ];
}

foreach ($jobs as $name =&gt; $jj) {
    if (!empty($jj['status']['last_ok_run']) &amp;&amp; $statLastRun === '-') {
        $tr = $jj['status']['transferred'] ?? '';
        $statLastRun = ($tr !== '' &amp;&amp; $tr !== '0' &amp;&amp; $tr !== '0 B') ? $tr : 'OK';
        if (!empty($jj['status']['secs'])) $statLastRun .= ' ('.$jj['status']['secs'].'s)';
    }
    $histFile = $storage.'/history/'.$name.'.jsonl';
    if (is_readable($histFile)) {
        $lines = @file($histFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        if ($lines) {
            foreach ($lines as $ln) {
                $e = @json_decode($ln, true);
                if ($e &amp;&amp; isset($e['ts']) &amp;&amp; ($now - (int)$e['ts']) &lt;= 86400) {
                    $k = date('Y-m-d H:00', (int)$e['ts']);
                    $b = (float)($e['bytes'] ?? 0);
                    if ($b &lt;= 0 &amp;&amp; !empty($e['transferred']) &amp;&amp; $e['transferred'] !== '0' &amp;&amp; $e['transferred'] !== '0 B') {
                        $b = rj_to_bytes($e['transferred']);
                    }
                    if ($b &lt;= 0 &amp;&amp; !empty($e['log'])) {
                        $b = rj_parse_log_bytes($e['log']);
                    }
                    $s = (int)($e['secs'] ?? 0);
                    if (isset($hourlySlots[$k])) {
                        $hourlySlots[$k]['bytes'] += $b;
                        $hourlySlots[$k]['runs']++;
                        $hourlySlots[$k]['secs'] += $s;
                    }
                    $statTotalRuns++;
                    $statBytesSum += $b;
                    if ($s &gt; 0) $statSecsSum += $s;
                }
            }
        }
    }
    $rollFile = $storage.'/history/'.$name.'.rollup.jsonl';
    if (is_readable($rollFile)) {
        $lines = @file($rollFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        if ($lines) {
            foreach ($lines as $ln) {
                $r = @json_decode($ln, true);
                if ($r &amp;&amp; ($r['rollup'] ?? '') === 'h' &amp;&amp; isset($r['ts']) &amp;&amp; ($now - (int)$r['ts']) &lt;= 86400) {
                    $k = date('Y-m-d H:00', (int)$r['ts']);
                    if (isset($hourlySlots[$k])) {
                        $hourlySlots[$k]['bytes'] += (float)($r['bytes'] ?? 0);
                        $hourlySlots[$k]['runs'] += (int)($r['runs'] ?? 0);
                    }
                }
            }
        }
    }
}

foreach ($hourlySlots as $slot) {
    if ($slot['bytes'] &gt; $peakBytes) $peakBytes = $slot['bytes'];
}

$chartMaxLabel = rj_fmt_bytes($peakBytes);
$chartMidLabel = rj_fmt_bytes($peakBytes / 2);

$hourlyStats = [];
foreach ($hourlySlots as $k =&gt; $slot) {
    $b1 = ($peakBytes &gt; 0 &amp;&amp; $slot['bytes'] &gt; 0) ? round(($slot['bytes'] / $peakBytes) * 100) : ($slot['runs'] &gt; 0 ? 15 : 4);
    $b2 = ($slot['runs'] &gt; 0) ? min(100, max(8, round($b1 * 0.7 + ($slot['runs'] * 12)))) : 3;
    $bTxt = rj_fmt_bytes($slot['bytes']);
    $title = $slot['title']." — {$bTxt} ({$slot['runs']} run".($slot['runs'] === 1 ? '' : 's').")";
    $hourlyStats[] = [
        'label'   =&gt; $slot['label'],
        'bar1Pct' =&gt; min(100, max(4, $b1)),
        'bar2Pct' =&gt; min(100, max(3, $b2)),
        'title'   =&gt; $title
    ];
}

$statAvgRate = '0 B/s';
if ($statBytesSum &gt; 0 &amp;&amp; $statSecsSum &gt; 0) {
    $statAvgRate = rj_fmt_bytes($statBytesSum / $statSecsSum).'/s';
} elseif ($statBytesSum &gt; 0) {
    $statAvgRate = rj_fmt_bytes($statBytesSum / 3).'/s';
}

$remotes = [];
$rcloneConf = '/boot/config/plugins/rclone/.rclone.conf';
if (is_readable($rcloneConf)) {
    $ini = @parse_ini_file($rcloneConf, true);
    if (is_array($ini)) {
        foreach (array_keys($ini) as $k) {
            $k = trim($k);
            if ($k !== '') $remotes[] = $k.':';
        }
    }
}
$shares = [];
foreach ((array)@glob('/mnt/user/*', GLOB_ONLYDIR) as $sh) {
    $b = basename($sh);
    if ($b !== '' &amp;&amp; $b[0] !== '.') $shares[] = '/mnt/user/'.$b;
}

$rjdata = [
    'version'    =&gt; '2026.09.10e',
    'storage'    =&gt; $storage,
    'master'     =&gt; $master,
    'quiet'      =&gt; ['start' =&gt; $quietSt, 'end' =&gt; $quietEn],
    'retention'  =&gt; $retention,
    'jobs'       =&gt; $jobs,
    'remotes'    =&gt; $remotes,
    'shares'     =&gt; $shares,
];
?&gt;
&lt;?php /* the page CSS is injected from an inline SCRIPT, not a &lt;style&gt; tag: inline
         style blocks inside .page content do not survive rendering on Unraid 7 (the
         tab strip showed up as a bare bulleted list), while inline scripts do. */ ?&gt;
&lt;script id="rj-style"&gt;
(function () {
  var css = [
    '#tab_rj_jobs input[type=text],#tab_rj_alerts input[type=text]{box-sizing:border-box;width:420px;max-width:100%}',
    '#tab_rj_jobs input.rj-size,#tab_rj_alerts input.rj-size{width:auto}',
    '#tab_rj_alerts #a_qstart,#tab_rj_alerts #a_qend{width:64px}',
    '#tab_rj_alerts #a_ntlevel{width:150px;max-width:100%}',
    '#tab_rj_jobs input[type=number],#tab_rj_alerts input[type=number]{width:64px}',
    '#tab_rj_jobs #f_sched_freq{width:180px;min-width:180px}',
    '#tab_rj_jobs #f_sched_hour,#tab_rj_jobs #f_sched_min,#tab_rj_jobs #f_sched_hmin,#tab_rj_jobs #f_sched_dom,#tab_rj_jobs #f_sched_nmin{width:64px}',
    '#tab_rj_jobs #f_s_at{margin:0 4px 0 6px;color:#8b98a3}',
    '#tab_rj_jobs .rj-wd{display:inline-flex;flex-wrap:wrap;gap:4px;align-items:center}',
