  <FILE Name="/usr/local/emhttp/plugins/rclone-jobs/rclone-jobs.page" Mode="0644">
<INLINE>
Menu="Utilities"
Title="rclone-jobs"
Icon="exchange"
---
&lt;?php
/* rclone-jobs v2026.09.09g - WebUI page (Settings tab).
   Rendered server-side; all mutations go through ajax.php (CSRF-checked). */
$RJ_PLUGIN = '/usr/local/emhttp/plugins/rclone-jobs';
$RJ_BOOT   = '/boot/config/plugins/rclone-jobs';
$RJ_ENGINE = $RJ_PLUGIN.'/engine/rclone-jobs.sh';

$csrf_token = $csrf_token ?? (parse_ini_file('/var/local/emhttp/var.ini')['csrf_token'] ?? '');

function rj_read_env($file) {
    $out = [];
    if (!is_readable($file)) return $out;
    foreach (file($file, FILE_IGNORE_NEW_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#' || strpos($line, '=') === false) continue;
        list($k, $v) = explode('=', $line, 2);
        $out[trim($k)] = trim($v, " \t\"");
    }
    return $out;
}
function rj_json($file) {
    if (!is_readable($file)) return null;
    $d = json_decode(file_get_contents($file), true);
    return is_array($d) ? $d : null;
}

$paths    = rj_read_env($RJ_BOOT.'/paths.env');
$storage  = $paths['STORAGE_ROOT'] ?? '';
if ($storage === '') {
    /* auto-detect: first /mnt/diskN on /dev/md* */
    foreach (glob('/mnt/disk[0-9]*') as $d) {
        $src = trim((string)@shell_exec('findmnt -no SOURCE -T ' . escapeshellarg($d) . ' 2&gt;/dev/null'));
        if (strpos($src, '/dev/md') === 0) { $storage = $d.'/.rclone-jobs'; break; }
    }
}
$master   = $paths['DRY_RUN_MASTER'] ?? 'yes';
$quietSt  = $paths['QUIET_START'] ?? '23:00';
$quietEn  = $paths['QUIET_END'] ?? '07:00';
function rj_ret($paths, $key, $def, $lo, $hi) {
    /* same defaults AND same clamps as the engine's load_paths()/num_clamp():
       a hand-edited paths.env value never reaches the fields as garbage */
    $v = $paths[$key] ?? '';
    if (!preg_match('/^\d{1,5}$/', $v)) return $def;
    return max($lo, min($hi, intval($v)));
}
$retention = [
    'rawHours'  =&gt; rj_ret($paths, 'HISTORY_RAW_HOURS', 24, 1, 168),
    'rawMax'    =&gt; rj_ret($paths, 'HISTORY_RAW_MAX', 500, 20, 5000),
    'hourDays'  =&gt; rj_ret($paths, 'HISTORY_HOUR_DAYS', 7, 1, 60),
    'days'      =&gt; rj_ret($paths, 'HISTORY_DAYS', 90, 7, 365),
    'logDays'   =&gt; rj_ret($paths, 'LOG_KEEP_DAYS', 3, 1, 90),
    'failDays'  =&gt; rj_ret($paths, 'LOG_KEEP_FAIL_DAYS', 14, 1, 90),
    'logMax'    =&gt; rj_ret($paths, 'LOG_KEEP_MAX', 300, 20, 20000),
];

$jobs = [];
foreach (glob($RJ_BOOT.'/jobs/*.conf') as $cf) {
    $name = basename($cf, '.conf');
    if (!preg_match('/^[A-Za-z0-9_-]{1,40}$/', $name)) continue;
    $cfg  = rj_read_env($cf);
    $st   = rj_json($storage.'/status/'.$name.'.json');
    $dry  = rj_json($storage.'/status/'.$name.'-dryrun.json');
    $jobs[$name] = ['conf' =&gt; $cfg, 'status' =&gt; $st, 'dryrun' =&gt; $dry];
}
$nEnabled = 0;
$nFailed  = 0;
foreach ($jobs as $jj) {
    if (($jj['conf']['ENABLED'] ?? 'yes') !== 'no') $nEnabled++;
    $rc = $jj['status']['rc'] ?? null;
    if ($rc !== null &amp;&amp; $rc !== '' &amp;&amp; (int)$rc !== 0 &amp;&amp; empty($jj['status']['running'])) $nFailed++;
}

function rj_to_bytes($s) {
    $s = trim((string)$s);
    if (!preg_match('/^([0-9.]+)\s*([KMGTPE]?i?B)?$/i', $s, $m)) return 0;
    $v = (float)$m[1];
    $u = strtoupper($m[2] ?? 'B');
    $mult = 1;
    if (strpos($u, 'K') === 0) $mult = 1024;
    elseif (strpos($u, 'M') === 0) $mult = 1048576;
    elseif (strpos($u, 'G') === 0) $mult = 1073741824;
    elseif (strpos($u, 'T') === 0) $mult = 1099511627776;
    return (float)($v * $mult);
}
function rj_parse_log_bytes($logfile) {
    if (!is_readable($logfile)) return 0;
    $fp = @fopen($logfile, 'r');
    if (!$fp) return 0;
    $stat = @fstat($fp);
    $size = $stat['size'] ?? 0;
    if ($size &gt; 32768) fseek($fp, $size - 32768);
    $data = fread($fp, 32768);
    fclose($fp);
    if (!$data) return 0;
    if (preg_match_all('/(?:INFO|NOTICE)\s*:\s+([0-9.]+ ?[KMGTPE]?i?B)\s*\//i', $data, $m)) {
        return rj_to_bytes(end($m[1]));
    }
    if (preg_match_all('/^\s*Transferred:\s+([0-9.]+ ?[KMGTPE]?i?B)/mi', $data, $m)) {
        return rj_to_bytes(end($m[1]));
    }
    return 0;
}

$bytes24 = 0;
$now = time();
foreach ($jobs as $name =&gt; $jj) {
    $histFile = $storage.'/history/'.$name.'.jsonl';
    if (is_readable($histFile)) {
        $lines = @file($histFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        if ($lines) {
            foreach ($lines as $ln) {
                $e = @json_decode($ln, true);
                if ($e &amp;&amp; isset($e['ts']) &amp;&amp; ($now - (int)$e['ts']) &lt;= 86400) {
                    $b = (float)($e['bytes'] ?? 0);
                    if ($b &lt;= 0 &amp;&amp; !empty($e['transferred']) &amp;&amp; $e['transferred'] !== '0' &amp;&amp; $e['transferred'] !== '0 B') {
                        $b = rj_to_bytes($e['transferred']);
                    }
                    if ($b &lt;= 0 &amp;&amp; !empty($e['log'])) {
                        $b = rj_parse_log_bytes($e['log']);
                    }
                    $bytes24 += $b;
                }
            }
        }
    } elseif (!empty($jj['status']['log']) &amp;&amp; !empty($jj['status']['last_ok']) &amp;&amp; ($now - (int)$jj['status']['last_ok']) &lt;= 86400) {
        $bytes24 += rj_parse_log_bytes($jj['status']['log']);
    }
}
function rj_fmt_bytes($b) {
    if ($b &lt;= 0) return '0 B';
    $u = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
    $i = 0;
    while ($b &gt;= 1024 &amp;&amp; $i &lt; 4) { $b /= 1024; $i++; }
    return ($i === 0 || $b &gt;= 100 ? round($b) : number_format($b, 1)).' '.$u[$i];
}
$b24Txt = rj_fmt_bytes($bytes24);

/* Hourly transfer statistics (last 16 hours) for the graph card */
$hourlySlots = [];
$peakBytes = 1;
$statTotalRuns = 0;
$statLastRun = '-';
$statSecsSum = 0;
$statBytesSum = 0;

for ($i = 15; $i &gt;= 0; $i--) {
    $hTs = strtotime("-$i hours");
    $hKey = date('Y-m-d H:00', $hTs);
    $hLabel = date('H', $hTs);
    $hourlySlots[$hKey] = [
        'label' =&gt; $hLabel,
        'bytes' =&gt; 0,
        'runs'  =&gt; 0,
        'fails' =&gt; 0,
        'secs'  =&gt; 0,
        'title' =&gt; date('M j, H:00', $hTs)
    ];
}

foreach ($jobs as $name =&gt; $jj) {
    if (!empty($jj['status']['last_ok_run']) &amp;&amp; $statLastRun === '-') {
        $tr = $jj['status']['transferred'] ?? '';
        $statLastRun = ($tr !== '' &amp;&amp; $tr !== '0' &amp;&amp; $tr !== '0 B') ? $tr : 'OK';
        if (!empty($jj['status']['secs'])) $statLastRun .= ' ('.$jj['status']['secs'].'s)';
    }
    $histFile = $storage.'/history/'.$name.'.jsonl';
    if (is_readable($histFile)) {
        $lines = @file($histFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        if ($lines) {
            foreach ($lines as $ln) {
                $e = @json_decode($ln, true);
                if ($e &amp;&amp; isset($e['ts']) &amp;&amp; ($now - (int)$e['ts']) &lt;= 86400) {
                    $k = date('Y-m-d H:00', (int)$e['ts']);
                    $b = (float)($e['bytes'] ?? 0);
                    if ($b &lt;= 0 &amp;&amp; !empty($e['transferred']) &amp;&amp; $e['transferred'] !== '0' &amp;&amp; $e['transferred'] !== '0 B') {
                        $b = rj_to_bytes($e['transferred']);
                    }
                    if ($b &lt;= 0 &amp;&amp; !empty($e['log'])) {
                        $b = rj_parse_log_bytes($e['log']);
                    }
                    $s = (int)($e['secs'] ?? 0);
                    if (isset($hourlySlots[$k])) {
                        $hourlySlots[$k]['bytes'] += $b;
                        $hourlySlots[$k]['runs']++;
                        $hourlySlots[$k]['secs'] += $s;
                    }
                    $statTotalRuns++;
                    $statBytesSum += $b;
                    if ($s &gt; 0) $statSecsSum += $s;
                }
            }
        }
    }
    $rollFile = $storage.'/history/'.$name.'.rollup.jsonl';
    if (is_readable($rollFile)) {
        $lines = @file($rollFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        if ($lines) {
            foreach ($lines as $ln) {
                $r = @json_decode($ln, true);
                if ($r &amp;&amp; ($r['rollup'] ?? '') === 'h' &amp;&amp; isset($r['ts']) &amp;&amp; ($now - (int)$r['ts']) &lt;= 86400) {
                    $k = date('Y-m-d H:00', (int)$r['ts']);
                    if (isset($hourlySlots[$k])) {
                        $hourlySlots[$k]['bytes'] += (float)($r['bytes'] ?? 0);
                        $hourlySlots[$k]['runs'] += (int)($r['runs'] ?? 0);
                    }
                }
            }
        }
    }
}

foreach ($hourlySlots as $slot) {
    if ($slot['bytes'] &gt; $peakBytes) $peakBytes = $slot['bytes'];
}

$chartMaxLabel = rj_fmt_bytes($peakBytes);
$chartMidLabel = rj_fmt_bytes($peakBytes / 2);

$hourlyStats = [];
foreach ($hourlySlots as $k =&gt; $slot) {
    $b1 = ($peakBytes &gt; 0 &amp;&amp; $slot['bytes'] &gt; 0) ? round(($slot['bytes'] / $peakBytes) * 100) : ($slot['runs'] &gt; 0 ? 15 : 4);
    $b2 = ($slot['runs'] &gt; 0) ? min(100, max(8, round($b1 * 0.7 + ($slot['runs'] * 12)))) : 3;
    $bTxt = rj_fmt_bytes($slot['bytes']);
    $title = $slot['title']." — {$bTxt} ({$slot['runs']} run".($slot['runs'] === 1 ? '' : 's').")";
    $hourlyStats[] = [
        'label'   =&gt; $slot['label'],
        'bar1Pct' =&gt; min(100, max(4, $b1)),
        'bar2Pct' =&gt; min(100, max(3, $b2)),
        'title'   =&gt; $title
    ];
}

$statAvgRate = '0 B/s';
if ($statBytesSum &gt; 0 &amp;&amp; $statSecsSum &gt; 0) {
    $statAvgRate = rj_fmt_bytes($statBytesSum / $statSecsSum).'/s';
} elseif ($statBytesSum &gt; 0) {
    $statAvgRate = rj_fmt_bytes($statBytesSum / 3).'/s';
}

$remotes = [];
$rcloneConf = '/boot/config/plugins/rclone/.rclone.conf';
if (is_readable($rcloneConf)) {
    $ini = @parse_ini_file($rcloneConf, true);
    if (is_array($ini)) {
        foreach (array_keys($ini) as $k) {
            $k = trim($k);
            if ($k !== '') $remotes[] = $k.':';
        }
    }
}
$shares = [];
foreach ((array)@glob('/mnt/user/*', GLOB_ONLYDIR) as $sh) {
    $b = basename($sh);
    if ($b !== '' &amp;&amp; $b[0] !== '.') $shares[] = '/mnt/user/'.$b;
}

$rjdata = [
    'version'    =&gt; '2026.09.09g',
    'storage'    =&gt; $storage,
    'master'     =&gt; $master,
    'quiet'      =&gt; ['start' =&gt; $quietSt, 'end' =&gt; $quietEn],
    'retention'  =&gt; $retention,
    'jobs'       =&gt; $jobs,
    'remotes'    =&gt; $remotes,
    'shares'     =&gt; $shares,
];
?&gt;
&lt;?php /* the page CSS is injected from an inline SCRIPT, not a &lt;style&gt; tag: inline
         style blocks inside .page content do not survive rendering on Unraid 7 (the
         tab strip showed up as a bare bulleted list), while inline scripts do. */ ?&gt;
&lt;script id="rj-style"&gt;
(function () {
  var css = [
    '#tab_rj_jobs input[type=text],#tab_rj_alerts input[type=text]{box-sizing:border-box;width:420px;max-width:100%}',
