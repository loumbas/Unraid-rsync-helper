  <FILE Name="/usr/local/emhttp/plugins/rclone-jobs/event/array_started" Mode="0755">
<INLINE>
#!/bin/bash
# rclone-jobs 'array_started' event - storage disks are mounted now: deploy the
# engine copy, create the storage tree, write the cron file.
set -u
NAME="rclone-jobs"
D="/usr/local/emhttp/plugins/$NAME"
logger -t "$NAME" -- "array_started event" 2&gt;/dev/null || true
[ -x "$D/scripts/install-engine.sh" ] &amp;&amp; "$D/scripts/install-engine.sh" &gt;/dev/null 2&gt;&amp;1
[ -x "$D/scripts/regen-cron.sh" ]     &amp;&amp; "$D/scripts/regen-cron.sh" &gt;/dev/null 2&gt;&amp;1
exit 0
</INLINE>
