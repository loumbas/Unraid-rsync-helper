    '#rj-sched-summary{margin:6px 0 6px 160px!important;padding:8px 12px!important;background:#141920!important;border:1px solid #28323c!important;border-radius:6px!important;font-size:11px!important;color:#9aa7b2!important;white-space:normal!important;line-height:1.4!important;max-width:680px!important}',
