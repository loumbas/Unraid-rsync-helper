    '.rj-live-dot.on{background:#2f8f46;box-shadow:0 0 8px #2f8f46;animation:rj-dot-pulse 2s infinite}',
    '.rj-live-dot.poll{background:#5a6570}',
    '.rj-live-dot.wait{background:#d9903a;animation:rj-dot-pulse 1s infinite}',
    '@keyframes rj-dot-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.85)}}',
