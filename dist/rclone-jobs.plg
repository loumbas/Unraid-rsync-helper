  <FILE Name="/usr/local/emhttp/plugins/rclone-jobs/event/array_started" Mode="0755">
<INLINE>
#!/bin/bash
# rclone-jobs 'array_started' event - storage disks are mounted now: deploy the
# engine copy, create the storage tree, write the cron file.
set -u
NAME="rclone-jobs"
D="/usr/local/emhttp/plugins/$NAME"
logger -t "$NAME" -- "array_started event" 2&gt;/dev/null || true
[ -x "$D/scripts/install-engine.sh" ] &amp;&amp; "$D/scripts/install-engine.sh" &gt;/dev/null 2&gt;&amp;1
[ -x "$D/scripts/regen-cron.sh" ]     &amp;&amp; "$D/scripts/regen-cron.sh" &gt;/dev/null 2&gt;&amp;1
exit 0
</INLINE>
<SHA256>361fffcc2806c5708e158ca935bdd9173eb5137cb4dd64e38c3fa08ff34df4cf</SHA256>
  </FILE>

  <FILE Name="/usr/local/emhttp/plugins/rclone-jobs/event/started" Mode="0755">
<INLINE>
#!/bin/bash
# rclone-jobs 'started' event - the general "system is up" hook. array_started can
# fire BEFORE the disks are actually mounted, in which case install-engine/regen
# deferred themselves; this is the guaranteed retry once /mnt/diskN are mounted.
# Idempotent and cheap (both scripts no-op when already in sync). Must never fail:
# always exit 0.
set -u
NAME="rclone-jobs"
D="/usr/local/emhttp/plugins/$NAME"
logger -t "$NAME" -- "started event (array-up retry)" 2&gt;/dev/null || true
[ -x "$D/scripts/install-engine.sh" ] &amp;&amp; "$D/scripts/install-engine.sh" &gt;/dev/null 2&gt;&amp;1
[ -x "$D/scripts/regen-cron.sh" ]     &amp;&amp; "$D/scripts/regen-cron.sh" &gt;/dev/null 2&gt;&amp;1
exit 0
</INLINE>
<SHA256>28a59bfb180f905827ea55e4314b981667f5e5be274bb42e6a2af2709604edb0</SHA256>
  </FILE>

  <FILE Name="/usr/local/emhttp/plugins/rclone-jobs/event/uninstalling" Mode="0755">
<INLINE>
#!/bin/bash
# rclone-jobs 'uninstalling' event - remove OUR cron file and stop OUR running
# jobs. User data (jobs/, paths.env, logs, status, backups, any legacy notify.env)
# is kept on the storage disk; the .plg remove script deletes only plugin-owned
# system files. Nothing outside rclone-jobs territory is touched.
set -u
NAME="rclone-jobs"
logger -t "$NAME" -- "uninstalling event: removing schedule block, stopping jobs (data kept)" 2&gt;/dev/null || true
CT=/var/spool/cron/crontabs/root
if [ -f "$CT" ] &amp;&amp; grep -qF "# $NAME BEGIN" "$CT"; then
  sed -i "/^# $NAME BEGIN/,/^# $NAME END/d" "$CT"
  /etc/rc.d/rc.crond restart &gt;/dev/null 2&gt;&amp;1 || true
fi
rm -f "/etc/cron.d/$NAME"   # legacy location, harmless if absent
pkill -f 'rclone-jobs\.sh run ' 2&gt;/dev/null || true
exit 0
</INLINE>
<SHA256>3798c8af2f9b84ec1f02dfebd50b8ae7daf092fe634dfca4c4af0a111aeb67f8</SHA256>
  </FILE>

  <FILE Name="/usr/local/emhttp/plugins/rclone-jobs/event/stopping" Mode="0755">
<INLINE>
#!/bin/bash
# rclone-jobs 'stopping' event - the array is about to stop. Jobs still
# transferring will be cut off; leave a loud trace (syslog + one bell notice).
# Everything is guarded and time-capped: a shutdown is NEVER delayed here.
set -u
NAME="rclone-jobs"
D="/usr/local/emhttp/plugins/$NAME"
E="$D/engine/rclone-jobs.sh"
if [ -x "$E" ]; then
  if command -v timeout &gt;/dev/null 2&gt;&amp;1; then
    timeout 10 /bin/bash "$E" shutdown-notice &gt;/dev/null 2&gt;&amp;1 || true
  else
    /bin/bash "$E" shutdown-notice &gt;/dev/null 2&gt;&amp;1 || true
  fi
fi
exit 0
</INLINE>
<SHA256>d7607e22f85f161234dd01287f44def63cfe5719f96c77781d84954a9ea58b2b</SHA256>
  </FILE>

