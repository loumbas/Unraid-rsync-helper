    'ul#rj-tabs&gt;li{list-style:none!important;display:block!important;float:none!important;width:auto!important;margin:0 3px -1px 0;padding:0;background:none;border:none}',
    'ul#rj-tabs&gt;li&gt;a{display:block;padding:9px 26px;font-size:12px;letter-spacing:0.5px;text-transform:uppercase;text-decoration:none;color:#93a0ab;background:transparent;border:1px solid transparent;border-bottom:none;border-radius:6px 6px 0 0;cursor:pointer;outline:none}',
    'ul#rj-tabs&gt;li&gt;a:hover{color:#e8eef3;background:rgba(128,128,128,0.12)}',
    'ul#rj-tabs&gt;li.active&gt;a{color:#fff;font-weight:bold;background:#20262d;border-color:#333d47;border-bottom:1px solid #20262d}',
    /* KPI Metric Cards Grid - Elevated contrast */
