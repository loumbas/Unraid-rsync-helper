    '#tab_rj_alerts #a_qstart,#tab_rj_alerts #a_qend{width:64px}',
    '#tab_rj_alerts #a_ntlevel{width:150px;max-width:100%}',
    '#tab_rj_jobs input[type=number],#tab_rj_alerts input[type=number]{width:64px}',
    '#tab_rj_jobs #f_sched_hour,#tab_rj_jobs #f_sched_min,#tab_rj_jobs #f_sched_hmin,#tab_rj_jobs #f_sched_dom{width:64px}',
    '#tab_rj_jobs #f_s_at{margin:0 2px 0 6px}',
    '#tab_rj_jobs .rj-wd label{margin-right:8px;white-space:nowrap}',
    '#rj-sched-summary{margin:4px 0 2px;font-size:11px;color:#9aa7b2}',
    '#rj-sched-summary.rj-warn{color:#e6867e}',
    '#tab_rj_jobs dd.rj-inline,#tab_rj_alerts dd.rj-inline{white-space:nowrap}',
