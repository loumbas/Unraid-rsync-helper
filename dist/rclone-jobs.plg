    '#tab_rj_jobs table.rclone-jobs tbody tr td{background:#20262d!important;padding:10px 8px;border:none;border-top:1px solid #2f3842!important;border-bottom:1px solid #2f3842!important;vertical-align:middle;transition:background 0.15s ease}',
    '#tab_rj_jobs table.rclone-jobs tbody tr:hover td{background:#262f38!important}',
