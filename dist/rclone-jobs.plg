    '.rj-spark-bar{width:12px;margin-right:3px;flex:0 0 auto;border-radius:2px 2px 0 0;transition:none!important}',
    '.rj-spark-bar:hover{filter:brightness(1.25);transition:none!important}',
    '#tab_rj_jobs tbody tr.rj-row-hist td{background:#27303a!important;border-bottom-color:#2e97c2!important}',
    '#tab_rj_jobs table.rclone-jobs tbody tr.rj-inline-hist-tr td{background:transparent!important;padding:4px 0 12px!important;border:none!important}',
    /* History Scrollable Table Containers */
    '.rj-hist-scroll{max-height:360px;overflow-y:auto;border:1px solid #333d47!important;border-radius:6px;margin-top:6px}',
