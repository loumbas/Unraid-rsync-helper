    '#tab_rj_jobs .rj-wd-btn:hover{border-color:#ff8c2f;color:#e8eef3}',
    '#tab_rj_jobs .rj-wd-btn.active{background:#ff8c2f;border-color:#ff8c2f;color:#111;font-weight:700}',
    '#tab_rj_jobs .rj-wd-btn input[type=checkbox]{display:none}',
    '#rj-sched-summary.rj-warn{border-color:#e6867e!important;color:#e6867e!important;background:rgba(230,134,126,0.08)!important}',
    '#tab_rj_jobs dd.rj-inline,#tab_rj_alerts dd.rj-inline{white-space:nowrap}',
