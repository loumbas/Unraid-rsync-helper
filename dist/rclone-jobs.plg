    '.rj-switch input{opacity:0;width:0;height:0;position:absolute;margin:0;pointer-events:none}',
    '.rj-slider{position:relative;display:inline-block;width:34px;height:18px;background:#323b44;transition:all 0.2s cubic-bezier(0.4,0,0.2,1);border-radius:18px;border:1px solid #485460;box-sizing:border-box}',
    '.rj-slider:before{position:absolute;content:"";height:12px;width:12px;left:2px;bottom:2px;background:#9aa7b2;transition:all 0.2s cubic-bezier(0.4,0,0.2,1);border-radius:50%}',
    '.rj-switch input:checked+.rj-slider{background:#2f8f46;border-color:#38a552}',
