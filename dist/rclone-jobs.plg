    '#tab_rj_jobs tbody tr.rj-row-editing td{background:#27303a!important;border-bottom-color:#ff8c2f!important}',
    '#rj-form-wrap{background:#181d24!important;border:1px solid #333d47!important;border-radius:8px!important;padding:18px 22px!important;margin:6px 0 14px!important;box-shadow:0 8px 24px rgba(0,0,0,0.45)!important;box-sizing:border-box!important;white-space:normal!important}',
    '.rj-form-header{display:flex;justify-content:space-between;align-items:center;padding-bottom:12px;margin-bottom:14px;border-bottom:1px solid #2e3740}',
    '.rj-form-title-badge{font-size:14px;font-weight:700;color:#e8eef3;display:flex;align-items:center;gap:8px}',
    '.rj-form-title-badge i{color:#ff8c2f;font-size:14px}',
    '.rj-form-close-x{background:transparent;border:none;color:#8b98a3;font-size:20px;cursor:pointer;line-height:1;padding:0 6px}',
    '.rj-form-close-x:hover{color:#ff8c2f}',
    '#rj-form-toggle{display:inline-flex;align-items:center;gap:8px;cursor:pointer;color:#e8eef3;text-decoration:none;font-weight:600;font-size:13px;padding:8px 14px;background:#20262d;border:1px solid #333d47;border-radius:6px;transition:all 0.15s ease}',
    '#rj-form-toggle:hover{border-color:#ff8c2f;color:#ff8c2f}',
    '#rj-form-toggle i{color:#93a0ab}',
    '.rj-fsec{font-size:11px!important;font-weight:700!important;letter-spacing:1px!important;text-transform:uppercase!important;color:#ff8c2f!important;border-bottom:1px solid #2e3740!important;padding:10px 0 6px!important;margin:16px 0 12px!important;display:flex!important;align-items:center!important;gap:6px!important;text-align:left!important}',
    '#rj-jobform{text-align:left!important;white-space:normal!important}',
    '#rj-jobform dl{display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;width:100%!important;max-width:850px!important;margin:6px 0!important;padding:0!important;float:none!important;clear:both!important;text-align:left!important}',
    '#rj-jobform dt{width:160px!important;min-width:160px!important;max-width:160px!important;float:none!important;text-align:left!important;font-weight:600!important;color:#c0ccd6!important;font-size:12px!important;padding:0!important;margin:0!important}',
    '#rj-jobform dd{width:auto!important;flex:1 1 auto!important;float:none!important;text-align:left!important;display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important;margin:0!important;padding:0!important}',
    '#rj-jobform dd.rj-inline{display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important;white-space:nowrap!important;flex-wrap:nowrap!important}',
    '#rj-jobform dd.rj-inline select,#rj-jobform dd.rj-inline input{margin:0!important;text-align:left!important}',
    '#rj-jobform dd.rj-inline span{display:inline-flex!important;align-items:center!important;gap:4px!important}',
    '#rj-jobform dd.rj-pathrow{width:100%!important;max-width:650px!important;display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important}',
    '#rj-jobform dd.rj-pathrow input[type=text]{flex:1 1 auto!important;max-width:440px!important}',
    '#rj-jobform input[type=text],#rj-jobform select{background:#111519!important;border:1px solid #333d47!important;border-radius:5px!important;color:#e8eef3!important;padding:5px 10px!important;height:30px!important;font-size:12px!important;box-sizing:border-box!important;text-align:left!important;margin:0!important}',
    '#rj-jobform input[type=text]:focus,#rj-jobform select:focus{border-color:#ff8c2f!important;box-shadow:0 0 0 1px #ff8c2f!important;outline:none!important}',
    '#rj-jobform input[type=number]{background:#111519!important;border:1px solid #333d47!important;border-radius:5px!important;color:#e8eef3!important;padding:5px 8px!important;height:30px!important;width:70px!important;font-size:12px!important;box-sizing:border-box!important;text-align:left!important;margin:0!important}',
    '#rj-jobform input[type=number]:focus{border-color:#ff8c2f!important;outline:none!important}',
    '#rj-form-wrap blockquote.inline_help,#rj-jobform blockquote.inline_help,#tab_rj_jobs blockquote.inline_help,#tab_rj_alerts blockquote.inline_help{margin:6px 0 12px 160px!important;padding:8px 14px!important;max-width:680px!important;width:calc(100% - 180px)!important;box-sizing:border-box!important;font-size:11px!important;color:#9aa7b2!important;border:1px solid #2e3842!important;border-left:3px solid #ff8c2f!important;background:#14191f!important;border-radius:4px!important;clear:both!important;text-align:left!important;white-space:normal!important;line-height:1.5!important;overflow-wrap:break-word!important;word-wrap:break-word!important}',
    '#rj-form-wrap blockquote.inline_help p,#rj-jobform blockquote.inline_help p,#tab_rj_jobs blockquote.inline_help p,#tab_rj_alerts blockquote.inline_help p{margin:0!important;padding:0!important;color:#9aa7b2!important;font-size:11px!important;line-height:1.5!important;white-space:normal!important;overflow-wrap:break-word!important;word-wrap:break-word!important}',
    '#rj-form-wrap blockquote.inline_help em,#rj-jobform blockquote.inline_help em,#tab_rj_jobs blockquote.inline_help em,#tab_rj_alerts blockquote.inline_help em{color:#22d3ee!important;font-style:normal!important;font-weight:600!important}',
    '#rj-sched-summary{margin:6px 0 6px 160px!important;font-size:11px!important;color:#9aa7b2!important;white-space:normal!important;line-height:1.4!important;max-width:680px!important}',
    '#rj-ov-note{margin:6px 0 6px 160px!important;font-size:11px!important;color:#e6867e!important;white-space:normal!important;line-height:1.4!important;max-width:680px!important}',
    '#rj-jobform .rj-browse-btn{height:28px!important;line-height:26px!important;padding:0 12px!important;font-size:11px!important;font-weight:600!important;text-transform:none!important;border:1px solid #ff8c2f!important;border-radius:4px!important;background:#20262d!important;color:#ff8c2f!important;cursor:pointer!important;transition:all 0.15s ease!important}',
    '#rj-jobform .rj-browse-btn:hover{background:#ff8c2f!important;color:#111!important}',
    '.rj-form-actions{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:10px!important;margin-top:20px!important;margin-left:160px!important;padding-top:14px!important;border-top:1px solid #2e3740!important}',
    '.rj-form-actions input[type=submit],.rj-form-actions input[type=button]{height:32px!important;line-height:30px!important;padding:0 18px!important;font-size:12px!important;font-weight:600!important;text-transform:none!important;border-radius:5px!important;cursor:pointer!important;transition:all 0.15s ease!important}',
    '.rj-form-actions input[type=submit]{border:1px solid #ff8c2f!important;background:#ff8c2f!important;color:#111!important;font-weight:700!important}',
    '.rj-form-actions input[type=submit]:hover{background:#ffa75e!important;border-color:#ffa75e!important}',
    '.rj-form-actions #rj-form-test{border:1px solid #ff8c2f!important;background:#20262d!important;color:#ff8c2f!important}',
    '.rj-form-actions #rj-form-test:hover{background:rgba(255,140,47,0.15)!important}',
    '.rj-form-actions #rj-form-cancel{border:1px solid #3e4a56!important;background:transparent!important;color:#9aa7b2!important}',
    '.rj-form-actions #rj-form-cancel:hover{border-color:#8b98a3!important;color:#e8eef3!important}'
  ].join('\n');
  var s = document.createElement('style');
  s.type = 'text/css';
  if (s.styleSheet) { s.styleSheet.cssText = css; } else { s.appendChild(document.createTextNode(css)); }
  (document.head || document.getElementsByTagName('head')[0]).appendChild(s);
})();
&lt;/script&gt;
&lt;script&gt;var rj_csrf = &lt;?= json_encode($csrf_token) ?&gt;;&lt;/script&gt;
&lt;script src="/plugins/rclone-jobs/js/rclone-jobs.js?v=2026.09.09g"&gt;&lt;/script&gt;
&lt;?php /* script content is RAW TEXT: entities are never decoded there, so the JSON
         goes out unescaped but with &lt; &gt; &amp; ' " hex-escaped (no &lt;/script&gt; breakout). */ ?&gt;
&lt;script type="application/json" id="rj-data"&gt;&lt;?= json_encode($rjdata, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?&gt;&lt;/script&gt;

&lt;ul class="tabs" id="rj-tabs"&gt;
  &lt;li&gt;&lt;a class="rj-tab" data-tab="tab_rj_jobs" tabindex="0" role="tab"&gt;Jobs&lt;/a&gt;&lt;/li&gt;
  &lt;li&gt;&lt;a class="rj-tab" data-tab="tab_rj_alerts" tabindex="0" role="tab"&gt;Alerts &amp;amp; Safety&lt;/a&gt;&lt;/li&gt;
  &lt;li&gt;&lt;a class="rj-tab" data-tab="tab_rj_doctor" tabindex="0" role="tab"&gt;Doctor&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;

  &lt;!-- ======================= JOBS TAB ======================= --&gt;
  &lt;div id="tab_rj_jobs"&gt;
    &lt;div class="rj-cards"&gt;
      &lt;div class="rj-card"&gt;
        &lt;div class="rj-card-title"&gt;&lt;i class="fa fa-tasks"&gt;&lt;/i&gt; Total Jobs&lt;/div&gt;
        &lt;div class="rj-card-val"&gt;&lt;span id="rj-card-active"&gt;&lt;?= $nEnabled ?&gt;&lt;/span&gt; &lt;span style="font-size:13px;font-weight:normal;color:#8b98a3"&gt;/ &lt;?= count($jobs) ?&gt; enabled&lt;/span&gt;&lt;/div&gt;
        &lt;div class="rj-card-sub"&gt;&lt;?= count($jobs) === 0 ? 'No jobs configured' : count($jobs).' total job'.(count($jobs) === 1 ? '' : 's') ?&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="rj-card"&gt;
        &lt;div class="rj-card-title"&gt;&lt;i class="fa fa-shield"&gt;&lt;/i&gt; Master Dry-Run&lt;/div&gt;
        &lt;div class="rj-card-val"&gt;
          &lt;span id="rj-master-pill" class="rj-pill &lt;?= $master === 'no' ? 'live' : 'dry' ?&gt;" title="&lt;?= $master === 'no' ? 'Scheduled runs perform real transfers (per-job dry-run settings still apply)' : 'Every scheduled run is simulated - change this on the Alerts &amp; Safety tab' ?&gt;"&gt;&lt;?= $master === 'no' ? 'LIVE RUNS' : 'ACTIVE (SAFE)' ?&gt;&lt;/span&gt;
        &lt;/div&gt;
        &lt;div class="rj-card-sub"&gt;&lt;?= $master === 'no' ? 'Transfers write real data' : 'All scheduled runs simulated' ?&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="rj-card"&gt;
        &lt;div class="rj-card-title"&gt;&lt;i class="fa fa-database"&gt;&lt;/i&gt; 24h Data Moved&lt;/div&gt;
        &lt;div class="rj-card-val"&gt;&lt;span id="rj-card-bytes"&gt;&lt;?= htmlspecialchars($b24Txt) ?&gt;&lt;/span&gt;&lt;/div&gt;
        &lt;div class="rj-card-sub"&gt;&lt;?= $bytes24 &gt; 0 ? 'Across active scheduled jobs' : 'No transfers in last 24h' ?&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="rj-card"&gt;
        &lt;div class="rj-card-title"&gt;&lt;i class="fa fa-heartbeat"&gt;&lt;/i&gt; Daemon Health&lt;/div&gt;
        &lt;div class="rj-card-val"&gt;&lt;span id="rj-live-ind"&gt;&lt;/span&gt;&lt;/div&gt;
        &lt;div class="rj-card-sub" id="rj-live-sub"&gt;Live status stream&lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;span id="rj-counts" style="display:none"&gt;&lt;?= count($jobs).' jobs · '.$nEnabled.' enabled' ?&gt;&lt;/span&gt;

    &lt;div class="rj-toolbar"&gt;
      &lt;div class="rj-tb-search"&gt;
        &lt;i class="fa fa-search"&gt;&lt;/i&gt;
        &lt;input type="text" id="rj-filter-search" placeholder="Search jobs, remotes, paths..." autocomplete="off"&gt;
      &lt;/div&gt;
      &lt;div class="rj-tb-right"&gt;
        &lt;div class="rj-tb-pills"&gt;
          &lt;button type="button" class="rj-filter-pill active" data-filter="all"&gt;All &lt;span class="rj-pill-cnt"&gt;&lt;?= count($jobs) ?&gt;&lt;/span&gt;&lt;/button&gt;
          &lt;button type="button" class="rj-filter-pill" data-filter="active"&gt;Active &lt;span class="rj-pill-cnt"&gt;&lt;?= $nEnabled ?&gt;&lt;/span&gt;&lt;/button&gt;
          &lt;button type="button" class="rj-filter-pill" data-filter="failed"&gt;Failed &lt;span class="rj-pill-cnt"&gt;&lt;?= $nFailed ?&gt;&lt;/span&gt;&lt;/button&gt;
        &lt;/div&gt;
        &lt;input type="button" id="rj-btn-add-top" class="rj-btn" value="+ Add New Job"&gt;
      &lt;/div&gt;
    &lt;/div&gt;

    &lt;table class="rclone-jobs view-table sortable"&gt;
      &lt;thead&gt;&lt;tr&gt;
        &lt;th&gt;Job&lt;/th&gt;&lt;th&gt;On&lt;/th&gt;&lt;th&gt;Schedule&lt;/th&gt;
        &lt;th&gt;Source → Destination&lt;/th&gt;&lt;th&gt;Last run&lt;/th&gt;&lt;th&gt;Last dry-run&lt;/th&gt;&lt;th&gt;Actions&lt;/th&gt;
      &lt;/tr&gt;&lt;/thead&gt;
      &lt;tbody&gt;
      &lt;?php if (count($jobs) === 0): ?&gt;
        &lt;tr&gt;&lt;td colspan="7" style="text-align:center;padding:14px"&gt;No jobs yet - use "Add job" below.&lt;/td&gt;&lt;/tr&gt;
      &lt;?php endif; ?&gt;
      &lt;?php foreach ($jobs as $name =&gt; $j):
          $c = $j['conf']; $s = $j['status']; $d = $j['dryrun'];
          $en = ($c['ENABLED'] ?? 'yes') === 'no' ? 'no' : 'yes';
          $running = !empty($s['running']);
          $rc = $s['rc'] ?? null;
          $rcTxt = $running ? 'RUN' : (($rc === null || $rc === '') ? '-' : (string)$rc);
          $run = $s['run'] ?? '-';
          $lastok = $s['last_ok_run'] ?? 'never';
          $dryshort = '-'; $dryfull = '';
          $needAck = false;
          if ($d) {
              $ts = (string)($d['stamp'] ?? '?');
              $dts = strlen($ts) &gt;= 16 ? substr($ts, 5, 5).' '.substr($ts, 11, 5) : $ts;
              $dryfull = $ts.' copy+'.($d['copies'] ?? 0).' del-'.($d['deletes'] ?? 0).' fail:'.($d['fails'] ?? 0);
              $dryshort = $dts.' +'.($d['copies'] ?? 0).' -'.($d['deletes'] ?? 0).' !'.($d['fails'] ?? 0);
              /* same rule as the engine's gate_check: deletions over the job's
                 WARN_DELETE threshold stay blocked for live runs until acked */
              $warn = isset($d['warnDelete']) ? (int)$d['warnDelete'] : (int)($c['WARN_DELETE'] ?? 0);
              $needAck = ($d['deletes'] ?? 0) &gt; $warn &amp;&amp; empty($d['ack']);
          }
          $ok = !$running &amp;&amp; preg_match('/^(0|24)$/', (string)$rc) &amp;&amp; $rc !== null &amp;&amp; $rc !== '';
          $rcDisplay = $rcTxt;
          if ($ok &amp;&amp; ((string)$rc === '0' || $rc === 0)) {
              $rcDisplay = 'OK';
          }
          /* row cue priority: running &gt; needs-ack &gt; ok / failed; disabled only dims */
          if ($running)     $stCls = 'rj-st-run';
          elseif ($needAck) $stCls = 'rj-st-ack';
          elseif ($ok)      $stCls = 'rj-st-ok';
          elseif ($rcTxt !== '-' &amp;&amp; $rcTxt !== 'RUN') $stCls = 'rj-st-bad';
          else              $stCls = '';
          if ($en === 'no') $stCls .= ' rj-off';
      ?&gt;
        &lt;tr data-job="&lt;?= htmlspecialchars($name) ?&gt;" class="rj-row &lt;?= $stCls ?&gt;"&gt;
          &lt;td&gt;
            &lt;div style="font-weight:600;font-size:13px;color:var(--text,#e8eef3)"&gt;&lt;?= htmlspecialchars($name) ?&gt;&lt;/div&gt;
            &lt;span class="rj-chip &lt;?= strtolower($c['ENGINE'] ?? 'rclone') ?&gt;"&gt;&lt;?= htmlspecialchars(($c['ENGINE'] ?? '?').(($c['MODE'] ?? '') !== '' ? '/'.$c['MODE'] : '')) ?&gt;&lt;/span&gt;
            &lt;?php if (($c['DESC'] ?? '') !== ''): ?&gt;&lt;br&gt;&lt;span class="gray"&gt;&lt;?= htmlspecialchars($c['DESC']) ?&gt;&lt;/span&gt;&lt;?php endif; ?&gt;
          &lt;/td&gt;
          &lt;td style="white-space:nowrap"&gt;
            &lt;label class="rj-switch" title="Click to &lt;?= $en === 'yes' ? 'disable' : 'enable' ?&gt; job"&gt;
              &lt;input type="checkbox" class="rj-toggle-en" data-job="&lt;?= htmlspecialchars($name) ?&gt;" &lt;?= $en === 'yes' ? 'checked' : '' ?&gt;&gt;
              &lt;span class="rj-slider"&gt;&lt;/span&gt;
            &lt;/label&gt;
            &lt;span class="rj-switch-text &lt;?= $en === 'yes' ? 'on' : 'off' ?&gt;"&gt;&lt;?= $en === 'yes' ? 'ON' : 'OFF' ?&gt;&lt;/span&gt;
          &lt;/td&gt;
          &lt;td class="rj-sched"&gt;&lt;?= htmlspecialchars($c['SCHEDULE'] ?? '(none)') ?&gt;&lt;/td&gt;
          &lt;?php
            $src = $c['SRC'] ?? '';
            $dst = $c['DST'] ?? '';
            $srcIsRemote = strpos($src, ':') !== false;
            $dstIsRemote = strpos($dst, ':') !== false;
          ?&gt;
          &lt;td&gt;
            &lt;div class="rj-path-container" title="&lt;?= htmlspecialchars($src.' -&gt; '.$dst) ?&gt;"&gt;
              &lt;span class="rj-path-endpoint"&gt;&lt;i class="fa &lt;?= $srcIsRemote ? 'fa-cloud' : 'fa-folder' ?&gt;" style="color:&lt;?= $srcIsRemote ? '#5cacee' : '#e5c07b' ?&gt;"&gt;&lt;/i&gt; &lt;?= htmlspecialchars($src) ?&gt;&lt;/span&gt;
              &lt;i class="fa fa-arrow-right rj-path-arrow"&gt;&lt;/i&gt;
              &lt;span class="rj-path-endpoint"&gt;&lt;i class="fa &lt;?= $dstIsRemote ? 'fa-cloud' : 'fa-folder' ?&gt;" style="color:&lt;?= $dstIsRemote ? '#5cacee' : '#e5c07b' ?&gt;"&gt;&lt;/i&gt; &lt;?= htmlspecialchars($dst) ?&gt;&lt;/span&gt;
            &lt;/div&gt;
          &lt;/td&gt;
          &lt;td style="white-space:nowrap"&gt;
            &lt;?php
              $trAmt = $s['transferred'] ?? '';
              $hasTr = ($trAmt !== '' &amp;&amp; $trAmt !== '0' &amp;&amp; $trAmt !== '0 B');
            ?&gt;
            &lt;span class="rj-rc&lt;?= $ok ? ' ok' : (($rcTxt !== '-' &amp;&amp; $rcTxt !== 'RUN') ? ' bad' : ($running ? ' run' : '')) ?&gt;"&gt;
              &lt;?php if ($ok): ?&gt;&lt;i class="fa fa-check-circle"&gt;&lt;/i&gt; &lt;?php elseif ($running): ?&gt;&lt;i class="fa fa-refresh fa-spin"&gt;&lt;/i&gt; &lt;?php elseif ($rcTxt !== '-'): ?&gt;&lt;i class="fa fa-times-circle"&gt;&lt;/i&gt; &lt;?php endif; ?&gt;
              &lt;?= htmlspecialchars($rcDisplay) ?&gt;&lt;?= $run !== '-' ? " (".htmlspecialchars((string)($s['secs'] ?? '?'))."s".($hasTr ? " · ".htmlspecialchars($trAmt) : '').")" : '' ?&gt;
            &lt;/span&gt;
            &lt;br&gt;&lt;span class="rj-lastok"&gt;last OK: &lt;?= htmlspecialchars((string)$lastok) ?&gt;&lt;/span&gt;
          &lt;/td&gt;
          &lt;td class="rj-dry"&lt;?= $dryfull !== '' ? ' title="'.htmlspecialchars($dryfull).'"' : '' ?&gt;&gt;
            &lt;?php if ($d): ?&gt;
              &lt;span class="rj-dry-ts"&gt;&lt;?= htmlspecialchars($dts) ?&gt;&lt;/span&gt;
              &lt;span class="rj-chip-diff rj-chip-add" title="Files copied/added"&gt;+&lt;?= (int)($d['copies'] ?? 0) ?&gt;&lt;/span&gt;
              &lt;span class="rj-chip-diff rj-chip-del" title="Files deleted"&gt;-&lt;?= (int)($d['deletes'] ?? 0) ?&gt;&lt;/span&gt;
              &lt;span class="rj-chip-diff rj-chip-err" title="Errors"&gt;!&lt;?= (int)($d['fails'] ?? 0) ?&gt;&lt;/span&gt;
              &lt;?php if ($needAck): ?&gt;&lt;span class="rj-needsack"&gt;needs ack&lt;/span&gt;&lt;?php endif; ?&gt;
            &lt;?php else: ?&gt;
              -
            &lt;?php endif; ?&gt;
          &lt;/td&gt;
          &lt;td class="rj-acts"&gt;
            &lt;span class="rj-act-grp"&gt;
              &lt;input type='button' value='Dry' class='rj-btn' data-act='dry' data-job='&lt;?= htmlspecialchars($name) ?&gt;' title='Dry-run: simulate only, nothing is written'&gt;
              &lt;input type='button' value='Run' class='rj-btn' data-act='run' data-job='&lt;?= htmlspecialchars($name) ?&gt;' title='Start a run now (respects the master dry-run switch)'&lt;?= $running ? " style='display:none'" : '' ?&gt;&gt;
              &lt;input type='button' value='Stop' class='rj-btn rj-del' data-act='stop' data-job='&lt;?= htmlspecialchars($name) ?&gt;' title='Stop the live run (interrupts the transfer; recorded as rc=143, next run resumes)'&lt;?= $running ? '' : " style='display:none'" ?&gt;&gt;
              &lt;?php if ($needAck): ?&gt;&lt;input type='button' value='Ack' class='rj-btn rj-warn' data-act='ack' data-job='&lt;?= htmlspecialchars($name) ?&gt;' title='This dry-run wants to delete files - acknowledge before a real run'&gt;&lt;?php endif; ?&gt;
            &lt;/span&gt;
            &lt;span class="rj-act-sep"&gt;&lt;/span&gt;
            &lt;span class="rj-act-grp"&gt;
              &lt;input type='button' value='Log' class='rj-btn' data-act='log' data-job='&lt;?= htmlspecialchars($name) ?&gt;' title='Open the last log (redacted) in a new window'&gt;
              &lt;input type='button' value='Hist' class='rj-btn' data-act='hist' data-job='&lt;?= htmlspecialchars($name) ?&gt;' title='Last 20 live runs + size trend'&gt;
            &lt;/span&gt;
            &lt;span class="rj-act-sep"&gt;&lt;/span&gt;
            &lt;span class="rj-act-grp"&gt;
              &lt;input type='button' value='Edit' class='rj-btn' data-act='edit' data-job='&lt;?= htmlspecialchars($name) ?&gt;' title='Edit this job'&gt;
              &lt;input type='button' value='Del' class='rj-btn rj-del' data-act='del' data-job='&lt;?= htmlspecialchars($name) ?&gt;' title='Delete this job (config kept as a .removed-* backup)'&gt;
            &lt;/span&gt;
          &lt;/td&gt;
        &lt;/tr&gt;
      &lt;?php endforeach; ?&gt;
      &lt;/tbody&gt;
    &lt;/table&gt;
    &lt;div id="rj-result" style="display:none;margin-top:10px"&gt;&lt;pre id="rj-result-pre" style="white-space:pre-wrap"&gt;&lt;/pre&gt;&lt;/div&gt;
    &lt;div id="rj-preview" style="display:none;margin-top:10px"&gt;&lt;pre id="rj-preview-pre" style="white-space:pre-wrap"&gt;&lt;/pre&gt;&lt;/div&gt;
    &lt;div id="rj-preview-ctl" style="display:none;margin-top:6px"&gt;&lt;input type="button" id="rj-preview-cancel" value="Cancel preview" class="rj-btn rj-del"&gt;&lt;/div&gt;
    &lt;div id="rj-history" style="display:none;margin-top:12px"&gt;&lt;/div&gt;

    &lt;!-- Hourly Transfer Bar Card from Mockup --&gt;
    &lt;div class="rj-chart-card"&gt;
      &lt;div class="rj-chart-header"&gt;
        &lt;div class="rj-chart-title"&gt;
          &lt;i class="fa fa-bar-chart"&gt;&lt;/i&gt;
          &lt;span&gt;Hourly Transfer Bar&lt;/span&gt;
        &lt;/div&gt;
        &lt;button type="button" class="rj-chart-toggle-btn" id="rj-chart-toggle" title="Toggle chart visibility"&gt;
          &lt;i class="fa fa-chevron-up"&gt;&lt;/i&gt;
        &lt;/button&gt;
      &lt;/div&gt;
      &lt;div class="rj-chart-body" id="rj-chart-body"&gt;
        &lt;div class="rj-chart-main"&gt;
          &lt;div class="rj-chart-y-axis"&gt;
            &lt;span id="rj-chart-y-max"&gt;&lt;?= htmlspecialchars($chartMaxLabel) ?&gt;&lt;/span&gt;
            &lt;span id="rj-chart-y-mid"&gt;&lt;?= htmlspecialchars($chartMidLabel) ?&gt;&lt;/span&gt;
            &lt;span&gt;0&lt;/span&gt;
          &lt;/div&gt;
          &lt;div class="rj-chart-bars-wrap"&gt;
            &lt;div class="rj-chart-grid-line top"&gt;&lt;/div&gt;
            &lt;div class="rj-chart-grid-line mid"&gt;&lt;/div&gt;
            &lt;div class="rj-chart-grid-line bot"&gt;&lt;/div&gt;
            &lt;div class="rj-chart-bars-cols"&gt;
              &lt;?php foreach ($hourlyStats as $slot): ?&gt;
                &lt;div class="rj-chart-col" title="&lt;?= htmlspecialchars($slot['title']) ?&gt;"&gt;
                  &lt;div class="rj-chart-bars-pair"&gt;
                    &lt;div class="rj-bar-cyan" style="height:&lt;?= (int)$slot['bar1Pct'] ?&gt;%"&gt;&lt;/div&gt;
                    &lt;div class="rj-bar-mint" style="height:&lt;?= (int)$slot['bar2Pct'] ?&gt;%"&gt;&lt;/div&gt;
                  &lt;/div&gt;
                  &lt;span class="rj-chart-x-lbl"&gt;&lt;?= htmlspecialchars($slot['label']) ?&gt;&lt;/span&gt;
                &lt;/div&gt;
              &lt;?php endforeach; ?&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
        &lt;div class="rj-chart-summary"&gt;
          &lt;div class="rj-sum-title"&gt;Stat Summary&lt;/div&gt;
          &lt;div class="rj-sum-row"&gt;
            &lt;span class="rj-sum-label"&gt;Avg Rate&lt;/span&gt;
            &lt;span class="rj-sum-val" id="rj-sum-rate"&gt;&lt;?= htmlspecialchars($statAvgRate) ?&gt;&lt;/span&gt;
          &lt;/div&gt;
          &lt;div class="rj-sum-row"&gt;
            &lt;span class="rj-sum-label"&gt;24h Transferred&lt;/span&gt;
            &lt;span class="rj-sum-val" id="rj-sum-transferred"&gt;&lt;?= htmlspecialchars($b24Txt) ?&gt;&lt;/span&gt;
          &lt;/div&gt;
          &lt;div class="rj-sum-row"&gt;
            &lt;span class="rj-sum-label"&gt;Total Runs&lt;/span&gt;
            &lt;span class="rj-sum-val" id="rj-sum-runs"&gt;&lt;?= (int)$statTotalRuns ?&gt;&lt;/span&gt;
          &lt;/div&gt;
          &lt;div class="rj-sum-row"&gt;
            &lt;span class="rj-sum-label"&gt;Last Run&lt;/span&gt;
            &lt;span class="rj-sum-val" id="rj-sum-last"&gt;&lt;?= htmlspecialchars($statLastRun) ?&gt;&lt;/span&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;

    &lt;div id="rj-form-slot-bottom"&gt;
      &lt;div class="title" style="margin-top:20px"&gt;
        &lt;a id="rj-form-toggle" tabindex="0" role="button" aria-expanded="false"&gt;&lt;i id="rj-form-chev" class='fa fa-chevron-down'&gt;&lt;/i&gt;&lt;i class='fa fa-wrench'&gt;&lt;/i&gt;&lt;span id="rj-form-title-accordion"&gt;Add job&lt;/span&gt;&lt;/a&gt;
      &lt;/div&gt;
      &lt;div id="rj-form-wrap" style="display:none"&gt;
        &lt;div class="rj-form-header"&gt;
          &lt;div class="rj-form-title-badge"&gt;
            &lt;i class="fa fa-sliders"&gt;&lt;/i&gt;
            &lt;span id="rj-form-title"&gt;Add job&lt;/span&gt;
          &lt;/div&gt;
          &lt;button type="button" id="rj-form-close" class="rj-form-close-x" title="Close form"&gt;&amp;times;&lt;/button&gt;
        &lt;/div&gt;
        &lt;form id="rj-jobform" autocomplete="off"&gt;
          &lt;input type="hidden" id="f_orig" value=""&gt;
          &lt;div class="rj-fsec"&gt;&lt;i class="fa fa-info-circle"&gt;&lt;/i&gt; Basics&lt;/div&gt;
          &lt;dl&gt;&lt;dt&gt;Name:&lt;/dt&gt;&lt;dd&gt;&lt;input type="text" id="f_name" maxlength="40" pattern="[A-Za-z0-9_-]{1,40}" required&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;Unique job id - letters, digits, dash and underscore, max 40 characters. It names the config file and the schedule entry, so it cannot be changed afterwards; to rename a job create a new one and delete the old.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Description:&lt;/dt&gt;&lt;dd&gt;&lt;input type="text" id="f_desc" maxlength="120"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;Free-text label shown under the job name in the jobs table.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Enabled:&lt;/dt&gt;&lt;dd&gt;&lt;select id="f_enabled"&gt;&lt;option value="yes"&gt;yes&lt;/option&gt;&lt;option value="no"&gt;no&lt;/option&gt;&lt;/select&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;A disabled job keeps its configuration and history but gets no schedule line. Manual Dry-run/Run buttons still work on disabled jobs.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Schedule:&lt;/dt&gt;&lt;dd class="rj-inline"&gt;
            &lt;select id="f_sched_freq"&gt;
              &lt;option value="minutely"&gt;Every&lt;/option&gt;
              &lt;option value="hourly"&gt;Hourly at minute&lt;/option&gt;
              &lt;option value="daily" selected&gt;Daily at&lt;/option&gt;
              &lt;option value="weekly"&gt;Weekly on&lt;/option&gt;
              &lt;option value="monthly"&gt;Monthly on day&lt;/option&gt;
              &lt;option value="custom"&gt;Custom (cron)&lt;/option&gt;
            &lt;/select&gt;
            &lt;span id="f_s_minutely" style="display:none"&gt;&lt;select id="f_sched_nmin"&gt;&lt;/select&gt; minutes&lt;/span&gt;
            &lt;span id="f_s_dom" style="display:none"&gt;&lt;select id="f_sched_dom"&gt;&lt;/select&gt;&lt;/span&gt;
            &lt;span id="f_s_weekday" class="rj-wd" style="display:none"&gt;&lt;/span&gt;
            &lt;span id="f_s_clock" style="display:none"&gt;&lt;span id="f_s_at" style="display:none"&gt;at&lt;/span&gt; &lt;select id="f_sched_hour"&gt;&lt;/select&gt;:&lt;select id="f_sched_min"&gt;&lt;/select&gt;&lt;/span&gt;
            &lt;span id="f_s_hourly" style="display:none"&gt;&lt;select id="f_sched_hmin"&gt;&lt;/select&gt;&lt;/span&gt;
          &lt;/dd&gt;&lt;/dl&gt;
          &lt;dl id="dl_f_schedule" style="display:none"&gt;&lt;dt&gt;Cron expression:&lt;/dt&gt;&lt;dd&gt;&lt;input type="text" id="f_schedule" class="rj-size" size="24" placeholder="30 3 * * *"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;p id="rj-sched-summary"&gt;&lt;/p&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;Pick how often the job runs - no cron knowledge needed; the generated expression and the next run times appear right below the fields. Times are the server's local time zone. &lt;em&gt;Custom (cron)&lt;/em&gt; accepts the classic five fields &lt;em&gt;minute hour day-of-month month day-of-week&lt;/em&gt; (numbers, &lt;em&gt;*&lt;/em&gt; and &lt;em&gt;,&lt;/em&gt; &lt;em&gt;-&lt;/em&gt; &lt;em&gt;/&lt;/em&gt; only), e.g. &lt;em&gt;0 5 * * 6&lt;/em&gt; = Saturday 05:00.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;div class="rj-fsec"&gt;&lt;i class="fa fa-exchange"&gt;&lt;/i&gt; Transfer&lt;/div&gt;
          &lt;dl&gt;&lt;dt&gt;Engine:&lt;/dt&gt;&lt;dd&gt;&lt;select id="f_engine"&gt;&lt;option value="rclone"&gt;rclone&lt;/option&gt;&lt;option value="rsync"&gt;rsync&lt;/option&gt;&lt;option value="custom"&gt;custom script&lt;/option&gt;&lt;/select&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;&lt;em&gt;rclone&lt;/em&gt; uses the rclone plugin's own remotes (same config, never modified). &lt;em&gt;rsync&lt;/em&gt; is for local/remote paths with mount-guard protection. &lt;em&gt;custom script&lt;/em&gt; runs your own executable instead - the transfer settings below do not apply to it.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;div class="rj-eng"&gt;
          &lt;dl&gt;&lt;dt&gt;Mode (rclone):&lt;/dt&gt;&lt;dd&gt;&lt;select id="f_mode"&gt;&lt;option value="sync"&gt;sync&lt;/option&gt;&lt;option value="copy"&gt;copy&lt;/option&gt;&lt;option value="check"&gt;check&lt;/option&gt;&lt;/select&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;&lt;em&gt;sync&lt;/em&gt; makes destination identical to source (may delete). &lt;em&gt;copy&lt;/em&gt; only adds/updates, never deletes. &lt;em&gt;check&lt;/em&gt; only compares and reports differences.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Source:&lt;/dt&gt;&lt;dd class="rj-pathrow"&gt;&lt;input type="text" id="f_src" class="variable rj-path" list="rj-paths-dl" placeholder="/mnt/user/data or remote:bucket/folder"&gt; &lt;input type="button" value="Browse..." class="rj-btn rj-browse-btn" data-target="f_src"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;Folder on this server (shares, array disks, mounts) or an rclone remote path like &lt;em&gt;gdrive:Data&lt;/em&gt;. Use Browse... to pick it; typing a not-yet-existing remote folder is allowed. The run refuses (with an alert) if a local source does not exist.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Destination:&lt;/dt&gt;&lt;dd class="rj-pathrow"&gt;&lt;input type="text" id="f_dst" class="variable rj-path" list="rj-paths-dl" placeholder="remote:backup/folder or /mnt/disk2/mirror"&gt; &lt;input type="button" value="Browse..." class="rj-btn rj-browse-btn" data-target="f_dst"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;Where files land. A local destination must already be a mounted directory - it is never auto-created, so an unmounted array/share is refused instead of filling RAM. New folders inside a valid destination are created by the engine.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;/div&gt;
          &lt;p id="rj-ov-note" style="display:none;margin:6px 0 2px;font-size:11px"&gt;&lt;/p&gt;
          &lt;div class="rj-custom" style="display:none"&gt;
          &lt;dl&gt;&lt;dt&gt;Script:&lt;/dt&gt;&lt;dd class="rj-pathrow"&gt;&lt;input type="text" id="f_script" class="variable rj-path" placeholder="/usr/local/emhttp/plugins/rclone-jobs/scripts/my-script.sh"&gt; &lt;input type="button" value="Browse..." class="rj-btn rj-browse-btn" data-target="f_script"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;Absolute path of an executable script; Browse... shows &lt;em&gt;.sh&lt;/em&gt; files under the plugins folder. The script runs as root with a hardened PATH; its exit code and output go into the job status and logs.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;/div&gt;
          &lt;div class="rj-fsec"&gt;&lt;i class="fa fa-shield"&gt;&lt;/i&gt; Limits &amp;amp; Notifications&lt;/div&gt;
          &lt;dl&gt;&lt;dt&gt;Per-job dry-run:&lt;/dt&gt;&lt;dd&gt;&lt;select id="f_dryrun"&gt;&lt;option value="yes"&gt;yes (preview only)&lt;/option&gt;&lt;option value="no"&gt;no (real transfer)&lt;/option&gt;&lt;/select&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;While &lt;em&gt;yes&lt;/em&gt;, scheduled runs only simulate. The master switch on the Alerts and Safety tab always wins: when it is ON, every scheduled run is a dry-run regardless of this setting.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Notify:&lt;/dt&gt;&lt;dd&gt;&lt;select id="f_notify"&gt;&lt;option value="always"&gt;always (OK + problems)&lt;/option&gt;&lt;option value="failures"&gt;failures &amp;amp; warnings only&lt;/option&gt;&lt;option value="off"&gt;off (silent)&lt;/option&gt;&lt;/select&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;When this job sends Unraid notifications: &lt;em&gt;always&lt;/em&gt; = an OK notice after each successful run plus notices for any problem; &lt;em&gt;failures&lt;/em&gt; = only failures, gate blocks, overlaps and watchdog findings; &lt;em&gt;off&lt;/em&gt; = nothing for this job (syslog and the job log are still written). The OK notice is additionally held back inside the quiet window. Delivery channels (bell, email, Telegram, ...) are chosen in Settings &amp;rarr; Notification Settings.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;div class="rj-eng"&gt;
          &lt;dl&gt;&lt;dt&gt;Transfers / Checkers:&lt;/dt&gt;&lt;dd class="rj-inline"&gt;&lt;input type="number" id="f_transfers" min="1" max="999" value="4"&gt; / &lt;input type="number" id="f_checkers" min="1" max="999" value="8"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;rclone parallelism: simultaneous file transfers and hash-check workers. Raise for many small files; lower on weak links.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Bandwidth limit:&lt;/dt&gt;&lt;dd&gt;&lt;input type="text" id="f_bwlimit" class="rj-size" size="10" placeholder="off"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;rclone syntax, e.g. &lt;em&gt;10M&lt;/em&gt; (10 MByte/s) or &lt;em&gt;off&lt;/em&gt; for unlimited. Only affects the rclone engine.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Max deletes / Warn deletes:&lt;/dt&gt;&lt;dd class="rj-inline"&gt;&lt;input type="number" id="f_maxdelete" min="0" max="999999999" value="100"&gt; / &lt;input type="number" id="f_warndelete" min="0" max="999999999" value="100"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;Sync modes only. &lt;em&gt;Max deletes&lt;/em&gt; is a hard cap - rclone aborts rather than deleting more. &lt;em&gt;Warn deletes&lt;/em&gt; makes a dry-run that wants to delete more of this many require an explicit Ack before a real run is allowed.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;dl&gt;&lt;dt&gt;Backup dir (optional):&lt;/dt&gt;&lt;dd class="rj-pathrow"&gt;&lt;input type="text" id="f_backupdir" class="variable rj-path" placeholder="remote:trash or STORAGE_ROOT subfolder - before-delete copy"&gt; &lt;input type="button" value="Browse..." class="rj-btn rj-browse-btn" data-target="f_backupdir"&gt;&lt;/dd&gt;&lt;/dl&gt;
          &lt;blockquote class='inline_help'&gt;&lt;p&gt;rclone &lt;em&gt;--backup-dir&lt;/em&gt;: files that would be deleted or overwritten are moved here first instead of disappearing. A remote like &lt;em&gt;gdrive:trash&lt;/em&gt; or a subfolder of the storage folder work well; leave empty to disable.&lt;/p&gt;&lt;/blockquote&gt;
          &lt;/div&gt;
          &lt;div class="rj-form-actions"&gt;
            &lt;input type="submit" value="Save Job" class="rj-btn"&gt;
            &lt;input type="button" id="rj-form-test" value="Test (Dry-run)" class="rj-btn"&gt;
            &lt;input type="button" id="rj-form-cancel" value="Cancel"&gt;
          &lt;/div&gt;
          &lt;datalist id="rj-paths-dl"&gt;&lt;/datalist&gt;
        &lt;/form&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;!-- ======================= ALERTS TAB ======================= --&gt;
  &lt;div id="tab_rj_alerts"&gt;
    &lt;div class="title"&gt;
      &lt;span class='left inline-flex flex-row items-center gap-1'&gt;&lt;i class='fa fa-lock title'&gt;&lt;/i&gt;Safety&lt;/span&gt;
    &lt;/div&gt;
    &lt;p&gt;&lt;/p&gt;
      &lt;dl&gt;&lt;dt&gt;Master dry-run switch:&lt;/dt&gt;
        &lt;dd&gt;&lt;select id="a_master"&gt;&lt;option value="yes"&gt;YES - all scheduled runs are dry-runs&lt;/option&gt;&lt;option value="no"&gt;no - scheduled runs transfer for real&lt;/option&gt;&lt;/select&gt;&lt;/dd&gt;&lt;/dl&gt;
      &lt;blockquote class='inline_help'&gt;&lt;p&gt;When YES, nothing is ever written by the schedule, regardless of per-job settings - every scheduled run is a simulation. Turn it off only after dry-runs of all jobs look right.&lt;/p&gt;&lt;/blockquote&gt;
      &lt;dl&gt;&lt;dt id="dt_quiet"&gt;Quiet window (heartbeats):&lt;/dt&gt;
        &lt;dd class="rj-inline"&gt;&lt;input type="text" id="a_qstart" class="rj-size" size="6" placeholder="23:00"&gt;&lt;span style="margin:0 8px"&gt;to&lt;/span&gt;&lt;input type="text" id="a_qend" class="rj-size" size="6" placeholder="07:00"&gt;&lt;/dd&gt;&lt;/dl&gt;
      &lt;blockquote class='inline_help'&gt;&lt;p&gt;24-hour clock. Inside this window the OK notices of successful runs are suppressed; failures and warnings are always sent.&lt;/p&gt;&lt;/blockquote&gt;
    &lt;div class="title"&gt;
      &lt;span class='left inline-flex flex-row items-center gap-1'&gt;&lt;i class='fa fa-hourglass title'&gt;&lt;/i&gt;Retention (history &amp;amp; logs)&lt;/span&gt;
    &lt;/div&gt;
    &lt;p&gt;&lt;/p&gt;
      &lt;dl&gt;&lt;dt&gt;Run history - raw per run:&lt;/dt&gt;
        &lt;dd class="rj-inline"&gt;&lt;input type="number" id="a_rawhours" min="1" max="168"&gt; hours (max &lt;input type="number" id="a_rawmax" min="20" max="5000"&gt; lines)&lt;/dd&gt;&lt;/dl&gt;
      &lt;dl&gt;&lt;dt&gt;History - hourly buckets:&lt;/dt&gt;
        &lt;dd class="rj-inline"&gt;keep &lt;input type="number" id="a_hourdays" min="1" max="60"&gt; days&lt;/dd&gt;&lt;/dl&gt;
      &lt;dl&gt;&lt;dt&gt;History - daily buckets:&lt;/dt&gt;
        &lt;dd class="rj-inline"&gt;keep &lt;input type="number" id="a_hdays" min="7" max="365"&gt; days&lt;/dd&gt;&lt;/dl&gt;
      &lt;blockquote class='inline_help'&gt;&lt;p&gt;Tiered history: every live run is stored as a raw line for the window above, then folded into one &lt;em&gt;hourly&lt;/em&gt; bucket (runs, failures, errors, duration min/max/sum, bytes) and later into one &lt;em&gt;daily&lt;/em&gt; bucket. A job that runs every few minutes therefore keeps a full 90-day trend in a few hundred lines instead of tens of thousands - the compaction runs automatically after runs and every 15 minutes via the managed cron block.&lt;/p&gt;&lt;/blockquote&gt;
      &lt;dl&gt;&lt;dt&gt;Job logs - successful:&lt;/dt&gt;
        &lt;dd class="rj-inline"&gt;keep &lt;input type="number" id="a_logdays" min="1" max="90"&gt; days, max &lt;input type="number" id="a_logmax" min="20" max="20000"&gt; files per job&lt;/dd&gt;&lt;/dl&gt;
      &lt;dl&gt;&lt;dt&gt;Job logs - failed:&lt;/dt&gt;
        &lt;dd class="rj-inline"&gt;keep &lt;input type="number" id="a_faildays" min="1" max="90"&gt; days&lt;/dd&gt;&lt;/dl&gt;
      &lt;blockquote class='inline_help'&gt;&lt;p&gt;Log files of OK and dry-run runs age out quickly (a 3-minute schedule produces ~480 files/day); failed and interrupted logs are kept longer and are never removed by the per-job count cap. The Log button of a finished run always shows its log while it exists.&lt;/p&gt;&lt;/blockquote&gt;
    &lt;div class="title"&gt;
      &lt;span class='left inline-flex flex-row items-center gap-1'&gt;&lt;i class='fa fa-bell title'&gt;&lt;/i&gt;Delivery (Unraid notifications)&lt;/span&gt;
    &lt;/div&gt;
    &lt;p&gt;&lt;/p&gt;
      &lt;dl&gt;&lt;dt&gt;Notification agents:&lt;/dt&gt;&lt;dd&gt;&lt;a href='/Settings/NotificationSettings'&gt;Settings &amp;rarr; Notification Settings&lt;/a&gt;&lt;/dd&gt;&lt;/dl&gt;
      &lt;blockquote class='inline_help'&gt;&lt;p&gt;Job alerts use Unraid's own notification system - nothing is configured here. That page decides which agents receive each importance level: the WebUI bell always gets them; email, Telegram, Discord, Slack and Pushover are enabled and set up there (the Telegram agent asks for the bot token and chat id once, system-wide). This plugin stores no credentials and never contacts a notification provider itself.&lt;/p&gt;&lt;/blockquote&gt;
      &lt;dl&gt;&lt;dt&gt;Test:&lt;/dt&gt;&lt;dd class="rj-inline"&gt;&lt;select id="a_ntlevel"&gt;&lt;option value="normal"&gt;normal&lt;/option&gt;&lt;option value="warning"&gt;warning&lt;/option&gt;&lt;option value="alert"&gt;alert&lt;/option&gt;&lt;/select&gt; &lt;input type="button" id="rj-nt-test" value="Send test notification" class="rj-btn"&gt;&lt;/dd&gt;&lt;/dl&gt;
      &lt;blockquote class='inline_help'&gt;&lt;p&gt;Sends one notification at the chosen level through the native notify script - check the bell and every agent you expect (Telegram only receives levels you ticked in Notification Settings).&lt;/p&gt;&lt;/blockquote&gt;
    &lt;div class="title"&gt;
      &lt;span class='left inline-flex flex-row items-center gap-1'&gt;&lt;i class='fa fa-exchange title'&gt;&lt;/i&gt;Job portability (export / import)&lt;/span&gt;
    &lt;/div&gt;
    &lt;p&gt;&lt;/p&gt;
      &lt;dl&gt;&lt;dt&gt;Export:&lt;/dt&gt;&lt;dd class="rj-inline"&gt;&lt;input type="button" id="rj-export" value="Download job set (.tgz)" class="rj-btn"&gt;&lt;/dd&gt;&lt;/dl&gt;
      &lt;blockquote class='inline_help'&gt;&lt;p&gt;Packs every job config plus a small meta.txt (plugin version, host, date) into one download for setting up another server. &lt;em&gt;Note:&lt;/em&gt; the archive contains your job names, paths, schedules and custom-script locations - nothing secret (rclone credentials always stay in this server's rclone config), but treat the file accordingly.&lt;/p&gt;&lt;/blockquote&gt;
      &lt;dl&gt;&lt;dt&gt;Import:&lt;/dt&gt;&lt;dd class="rj-inline"&gt;
        &lt;select id="a_importmode"&gt;&lt;option value="ask"&gt;ask - report conflicts, change nothing&lt;/option&gt;&lt;option value="overwrite"&gt;overwrite same-named jobs&lt;/option&gt;&lt;option value="skip"&gt;keep same-named jobs&lt;/option&gt;&lt;/select&gt;
        &lt;input type="button" id="rj-import-btn" value="Choose archive..." class="rj-btn"&gt;
        &lt;input type="file" id="a_import_file" accept=".tgz,.gz,application/gzip" style="display:none"&gt;
      &lt;/dd&gt;&lt;/dl&gt;
      &lt;blockquote class='inline_help'&gt;&lt;p&gt;Every member of the archive is re-validated with the exact same rules as saving a job (name, engine, paths, schedule, storage policy at run time); anything invalid is rejected individually and never written. Existing jobs are only replaced in &lt;em&gt;overwrite&lt;/em&gt; mode, and a replaced config is kept next to it as a &lt;em&gt;.pre-import-&lt;/em&gt; backup first. Remote names must already exist in this server's rclone config or the imported job will refuse to run until they do.&lt;/p&gt;&lt;/blockquote&gt;
    &lt;dl&gt;
      &lt;dt&gt;&amp;nbsp;&lt;/dt&gt;
      &lt;dd&gt;&lt;input type="button" id="rj-save-alerts" value="Save settings" class="rj-btn"&gt;&lt;/dd&gt;
    &lt;/dl&gt;
    &lt;div id="rj-alerts-result" style="display:none"&gt;&lt;pre&gt;&lt;/pre&gt;&lt;/div&gt;
  &lt;/div&gt;

  &lt;!-- ======================= DOCTOR TAB ======================= --&gt;
  &lt;div id="tab_rj_doctor"&gt;
    &lt;div class="title"&gt;
      &lt;span class='left inline-flex flex-row items-center gap-1'&gt;&lt;i class='fa fa-stethoscope title'&gt;&lt;/i&gt;Doctor&lt;/span&gt;
    &lt;/div&gt;
    &lt;details id="rj-doctor-about"&gt;&lt;summary class="gray"&gt;What does Doctor check? (click to expand)&lt;/summary&gt;&lt;p class="gray"&gt;Doctor is a read-only self-test of the whole setup: plugin/engine versions, the rclone plugin's wrapper and config file, the storage folder (share policy, writability, free space), required binaries and php, the cron integration (our managed block in the root crontab, drift against the jobs folder, the cron daemon), every job config (validity, storage overlap, last-run status, staleness) and rclone's behavior under cron's minimal PATH. It changes nothing - the only side effect is a copy of the report saved under the plugin's logs folder. PASS = healthy, INFO = detail, WARN = worth a look, FAIL = broken (schedules cannot be trusted until fixed). The fenced block at the end of the output is a paste-ready summary for support threads. The checkbox additionally sends one test notification through Unraid's own notify system (bell + the agents enabled under Settings &amp;rarr; Notification Settings).&lt;/p&gt;&lt;/details&gt;
    &lt;p&gt;&lt;input type="button" id="rj-doctor" value="Run doctor" class="rj-btn"&gt;
       &lt;input type="checkbox" id="rj-doctor-notify"&gt; include test notification (bell + your enabled agents)&lt;/p&gt;
    &lt;pre id="rj-doctor-pre" style="white-space:pre-wrap;min-height:120px"&gt;Not run yet.&lt;/pre&gt;
  &lt;/div&gt;

&lt;p class="gray" style="margin-top:16px;font-size:11px"&gt;rclone-jobs v2026.09.09g &amp;middot; storage: &lt;?= htmlspecialchars($storage !== '' ? $storage : 'not set (start the array)') ?&gt;&lt;/p&gt;
</INLINE>
